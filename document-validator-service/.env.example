# ===========================================
# Document Validator Service Configuration
# ===========================================

# Service Configuration
SERVICE_NAME=document-validator
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8002

# Redis Configuration (use database 2 to avoid conflicts)
# For Docker: redis://host.docker.internal:6379/2
# For local: redis://127.0.0.1:6379/2
REDIS_URL=redis://127.0.0.1:6379/2

# MinIO/S3 Configuration
# For Docker: http://host.docker.internal:9000
# For local: http://127.0.0.1:9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hiralent-uploads
S3_SECURE=false

# OCR Configuration
# Multiple languages supported (use + to combine):
# eng=English, fra=French, ara=Arabic, spa=Spanish, deu=German, por=Portuguese
# rus=Russian, chi_sim=Chinese, ita=Italian, nld=Dutch, jpn=Japanese, kor=Korean
OCR_LANGS=eng+fra+ara+spa+deu+por+rus+chi_sim+ita+nld+jpn+kor
OCR_CONFIDENCE_THRESHOLD=0.85
TESSERACT_CMD=/usr/bin/tesseract

# Webhook Configuration
BACKEND_WEBHOOK_URL=http://host.docker.internal:5000/api/v1/webhooks/document-validation

# Timeouts
VALIDATION_TIMEOUT_SECONDS=120
