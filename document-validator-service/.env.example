# ===========================================
# Document Validator Service Configuration
# ===========================================

# Service Configuration
SERVICE_NAME=document-validator
SERVICE_VERSION=1.0.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8002

# CORS (comma-separated origins allowed to call this service)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Redis Configuration (use database 2 to avoid conflicts)
# For Docker: redis://host.docker.internal:6379/2
# For local: redis://127.0.0.1:6379/2
REDIS_URL=redis://127.0.0.1:6379/2

# MinIO/S3 Configuration
# For Docker: http://host.docker.internal:9000
# For local: http://127.0.0.1:9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=hiralent-uploads
S3_SECURE=false

# OCR Configuration
# Core languages for MVP (balanced coverage without confusion):
# eng=English (international), fra=French (France/Morocco/Africa), ara=Arabic (MENA), spa=Spanish (Spain/LatAm)
OCR_LANGS=eng+fra+ara+spa
OCR_CONFIDENCE_THRESHOLD=0.30
# Min image width (px) targeted after upscale (A4 ~2480px @300dpi; 1800 = perf/quality balance)
OCR_TARGET_MIN_WIDTH=1800
TESSERACT_CMD=/usr/bin/tesseract
USE_EASYOCR=true

# Webhook Configuration
# Local dev: http://host.docker.internal:5000/api/v1/webhooks/document-validation
# Production: https://your-backend-domain.com/api/v1/webhooks/document-validation
BACKEND_WEBHOOK_URL=http://host.docker.internal:5000/api/v1/webhooks/document-validation

# Timeouts
VALIDATION_TIMEOUT_SECONDS=120

# Internal service auth (Phase 1.7)
# BACKEND_INTERNAL_TOKEN: token this service sends OUTBOUND on the webhook callback.
# INTERNAL_API_TOKEN: token this service REQUIRES INBOUND (X-API-Token) on /documents/*;
#                     unset = fail-closed (500). MUST match INTERNAL_API_TOKEN in backend/.env.
BACKEND_INTERNAL_TOKEN=your-shared-secret-token-here
INTERNAL_API_TOKEN=CHANGE_ME_internal_token

# AI Configuration
# Use either OpenAI (OPENAI_API_KEY) or Google Gemini (GEMINI_API_KEY)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini
