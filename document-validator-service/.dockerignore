# document-validator-service/.dockerignore
# The Dockerfile does `COPY . .`, so exclude secrets and cruft from the build context —
# otherwise the service's .env (real credentials) would ship inside the image (R-14).
# Provide env at runtime via docker-compose env_file / orchestrator secrets.

# Secrets & VCS
.env
.env.*
!.env.example
.git
.gitignore

# Python cruft
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Build / editor / OS
dist/
build/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker / docs (not needed inside the image)
Dockerfile
docker-compose.yml
README.md
