# ─────────────────────────────────────────────────────────────
#  FILE LOCATION: backend/Dockerfile.workers
# ─────────────────────────────────────────────────────────────

FROM node:20-alpine

# FIX: canvas needs Python + native build tools to compile
# docker-cli needed by run.worker.ts to spawn code execution containers
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    pixman-dev \
    pangomm-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    docker-cli

WORKDIR /app

# Copy manifest + lockfile + pnpm settings FIRST (Docker caches this layer — only re-installs when these change)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma/

# Enable pnpm (bundled with Node via corepack) and install deps (canvas compiles via the build tools above)
RUN corepack enable && pnpm install --frozen-lockfile

# Generate Prisma client
RUN pnpm exec prisma generate

# Copy source code
COPY . .

# No CMD — docker-compose.workers.yml sets the command per worker