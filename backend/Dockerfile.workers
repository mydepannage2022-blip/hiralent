# ─────────────────────────────────────────────────────────────
#  FILE LOCATION: backend/Dockerfile.workers
# ─────────────────────────────────────────────────────────────

FROM node:20-alpine

# FIX: canvas needs Python + native build tools to compile
# docker-cli needed by run.worker.ts to spawn code execution containers
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    pixman-dev \
    pangomm-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    docker-cli

WORKDIR /app

# Copy package files FIRST (Docker caches this layer — only re-installs when package.json changes)
COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies (canvas will now compile successfully)
RUN npm ci

# Generate Prisma client
RUN npx prisma generate

# Copy source code
COPY . .

# No CMD — docker-compose.workers.yml sets the command per worker