# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/talenta_db"

# MongoDB Configuration (for file metadata)
MONGO_URI="mongodb://localhost:27017/talenta_files"

# JWT Configuration
JWT_SECRET="super-secret-jwt-key-for-development-only"

# OpenAI Configuration (for AI features)
OPENAI_API_KEY="sk-placeholder-openai-key"

# Pinecone Configuration (for vector database)
PINECONE_API_KEY="placeholder-pinecone-key"
PINECONE_ENVIRONMENT="us-east-1"
PINECONE_INDEX_NAME="talenta-candidates"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="placeholder@gmail.com"
SMTP_PASS="placeholder-password"
SMTP_FROM="placeholder@gmail.com"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3000"

# Server Configuration
PORT=3001

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760