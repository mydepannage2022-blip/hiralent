# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/talenta_db"

# MongoDB Configuration (for file metadata)
MONGO_URI="mongodb://localhost:27017/talenta_files"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here"

# OpenAI Configuration (for AI features)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Pinecone Configuration (for vector database)
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-east-1"
PINECONE_INDEX_NAME="talenta-candidates"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-email-password"
SMTP_FROM="your-email@gmail.com"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3000"

# Server Configuration
PORT=3001

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Firebase Configuration (optional)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"