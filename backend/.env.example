# ===========================================
# Hiralent Backend — Environment Example
# ===========================================
# Copy to `.env` and fill in real values. NEVER commit `.env` (it holds secrets).
# Secrets are shown as placeholders (CHANGE_ME / your-...). Insecure dev defaults
# are marked "rotate before prod (Wave 1)".

# ---------- Core / server ----------
PORT=5000
NODE_ENV=development
# ENABLE_DEV_MINT=1 — LOCAL DEV ONLY. Enables the /dev helper routes (double-gated
# with NODE_ENV !== 'production') and lets signup continue if the SMTP send fails.
# MUST stay unset/0 in staging & production (it un-gates dangerous dev endpoints).
# ENABLE_DEV_MINT=1
APP_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------- Database (Postgres / Prisma) ----------
# Required at boot. This is the POOLED (runtime) path used by Prisma Client.
# The ?connection_limit / ?pool_timeout params BOUND each process's connection pool
# (R-06, Wave 2 / Phase 2.1). Without them Prisma defaults to cpus*2+1 per process,
# and with 1 API server + 6 workers each opening a pool that can overrun Postgres.
# POOL MATH: (1 server + 6 workers) × connection_limit  MUST stay under Postgres
#   max_connections (default 100), leaving headroom for migrations/monitoring.
#   e.g. 7 × 10 = 70 (~30 spare).  connection_limit=10, pool_timeout=20s (queue wait).
# WAVE 8 (PgBouncer transaction pooling): point the host at the pgbouncer service
#   (docker-compose.yml, port 6432) and add &pgbouncer=true, e.g.
#   DATABASE_URL="postgresql://postgres:password@pgbouncer:6432/hiralent?pgbouncer=true&connection_limit=10&pool_timeout=20"
DATABASE_URL="postgresql://postgres:password@localhost:5432/hiralent?connection_limit=10&pool_timeout=20"
# DIRECT_DATABASE_URL — the DIRECT, un-pooled path used by `prisma migrate` (schema.prisma
# `directUrl`). Migrations must BYPASS PgBouncer (transaction pooling breaks DDL), so this
# points straight at Postgres (5432) and carries NO connection_limit / pgbouncer params.
# Runtime (Prisma Client) never uses it, but `prisma migrate`/`prisma validate` REQUIRE it —
# set it wherever you run migrations.
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/hiralent"
# SHADOW_DATABASE_URL — keep UNSET (deploy uses `prisma migrate deploy`, no shadow DB needed).
# Local `prisma migrate dev` auto-creates its own throwaway shadow DB via the superuser.
# NEVER point this at the primary/DATABASE_URL — `migrate dev` would WIPE the primary DB. (R-07)
# If a restricted DB user forces it, use a SEPARATE throwaway database:
# SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/hiralent_shadow"

# ---------- Redis (queues / BullMQ) ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- Auth / JWT ----------
JWT_SECRET=CHANGE_ME_high_entropy_secret        # rotate before prod (Wave 1, R-01)
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=CHANGE_ME_admin_secret          # rotate before prod (Wave 1)
ADMIN_SESSION_DURATION=8h
# Superadmin bootstrap seed (prisma/seeds/superadmin.seed.ts). In dev these fall back to
# admin@hiralent.com / hiralent1234@. In PRODUCTION set SUPERADMIN_PASSWORD or the seed
# skips admin creation (never ships a known default password). Rotate after first login.
SUPERADMIN_EMAIL=admin@hiralent.com
# SUPERADMIN_PASSWORD=set-a-strong-password-in-prod
# Short-lived access token; the frontend silently rotates it via POST /auth/refresh (Wave 1, R-29).
ACCESS_TOKEN_TTL=15m
# Refresh-token / session lifetime in days.
REFRESH_TOKEN_TTL_DAYS=7
# HMAC secret for signed CV/resume file URLs (Wave 1, Phase 1.3). Uploaded files are
# no longer served publicly — GET /api/v1/files/:token verifies a short-lived signed
# token instead. Falls back to JWT_SECRET if unset, but set a distinct value in prod.
FILE_URL_SECRET=CHANGE_ME_file_url_secret
# Signed file-URL lifetime in seconds (default 600 = 10 min).
FILE_URL_TTL_SECONDS=600
# Submission SSE stream-ticket lifetime in seconds (default 300 = 5 min). The ticket is
# minted behind checkAuth+ownership and signed with FILE_URL_SECRET/JWT_SECRET. Kept short
# so a leaked stream URL expires fast, but long enough to survive a reconnect blip.
STREAM_TICKET_TTL_SECONDS=300

# ---------- Google OAuth (optional — Google login) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ---------- Firebase (optional — token verification; lazy-init, safe if unset) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes on one line, wrapped in quotes.
FIREBASE_PRIVATE_KEY=""

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                                       # secret
SMTP_FROM=no-reply@example.com

# ---------- AI providers / services ----------
AI_MODEL_PROVIDER=gemini
AI_FAKE=0
GEMINI_API_KEY=                                  # secret
OPENAI_API_KEY=                                  # secret
AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_BASE_URL=http://localhost:8000
# AI_VETTING_URL=http://localhost:8000
# DOC_VALIDATOR_URL=http://localhost:8002
# TALENT_AI_BASE_URL=http://localhost:8003
# MATCHING_AI_BASE_URL=http://localhost:8011   # matching-candidate-job service (client + service default is 8011)

# ---------- Vector DB (Pinecone) ----------
PINECONE_API_KEY=                                # secret
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=hiralent-candidates          # auto-created on first use

# ---------- Storage (MinIO / S3) ----------
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=hiralent-uploads
S3_ACCESS_KEY=CHANGE_ME                          # secret — never commit a real value
S3_SECRET_KEY=CHANGE_ME                          # secret — never commit a real value
S3_FORCE_PATH_STYLE=true                         # required for MinIO path-style URLs
CLOUDINARY_URL=                                  # secret (optional media)

# ---------- External signals (company verification / onboarding) ----------
# Non-secret tunables for the whois (RDAP) + website-scrape signals used by the AI company
# onboarding worker (src/services/signals/*). All optional — safe defaults apply if unset.
SIGNALS_SCRAPE_ENABLED=true                      # false ⇒ website scrape returns '' (no fetch)
SIGNALS_RDAP_BASE=https://rdap.org               # keyless RDAP bootstrap redirector (domain age)
SIGNALS_HTTP_TIMEOUT_MS=8000                     # per-request timeout for RDAP + website fetch
SIGNALS_MAX_BYTES=2000000                        # response byte cap for the website fetch (~2 MB)

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760                           # 10 MB
MAX_UPLOAD_BYTES=15728640                        # 15 MB
ALLOWED_MIME=image/png,image/jpeg,application/pdf
SIGNED_URL_TTL_SECONDS=600

# ---------- OCR ----------
OCR_LANGS=eng+fra
OCR_HANDWRITING=1
OCR_TARGET_MIN_W=1800
# Max upload size for the authenticated POST /api/ocr endpoint (bytes; default 10MB).
OCR_MAX_UPLOAD_BYTES=10485760

# ---------- Antivirus (optional) ----------
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
DISABLE_AV=1                                      # set 0 when ClamAV is running

# ---------- Networking (optional) ----------
TAILSCALE_ENABLED=false

# ---------- Edge: CORS, headers, rate limiting, body limits (Phase 1.5) ----------
# Comma-separated browser origins allowed to call the API with credentials.
# In non-production, any http://localhost origin is additionally allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://hiralent.vercel.app
# Reverse-proxy hops to trust for the real client IP (rate-limit key). 1 = one proxy.
TRUST_PROXY=1
# Max JSON request body (size string, e.g. 100kb / 1mb). Oversized -> 413.
JSON_BODY_LIMIT=1mb
# Rate limits — shared across instances when REDIS_URL is set, else per-process.
# *_WINDOW_MS is the window in ms; *_MAX is requests per window per client IP.
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_OCR_WINDOW_MS=900000
RATE_LIMIT_OCR_MAX=30
RATE_LIMIT_SUBMISSION_WINDOW_MS=900000
RATE_LIMIT_SUBMISSION_MAX=60
RATE_LIMIT_AI_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=60
# Optional namespace for Redis rate-limit keys (isolate deployments/tests on one Redis).
# RATE_LIMIT_PREFIX=
# Kill-switch: set to 1 to force the in-memory limiter store even when REDIS_URL is set.
# RATE_LIMIT_FORCE_MEMORY=

# ---------- Code runner (optional — pin for prod, Wave 6/8) ----------
# RUNNER_MODE=docker
# RUNNER_HTTP_URL=
# RUNNER_PY_IMAGE=
# RUNNER_TS_IMAGE=
# RUNNER_DOCKER_CPUS=1
# RUNNER_DOCKER_MEMORY=256m
# RUNNER_TIMEOUT_MS=10000
# Container hardening (R-03). Non-root user + PID cap for the runner container.
# RUNNER_DOCKER_USER=1000:1000
# RUNNER_PIDS_LIMIT=128
# Shared secret for the HTTP runner stub (constant-time X-Runner-Token). REQUIRED if
# RUNNER_HTTP_URL is set in production (the stub refuses to run without it).
# RUNNER_STUB_TOKEN=CHANGE_ME_runner_stub_token
# DEV-ONLY escape hatch: run candidate code on the host when no container runner exists.
# HARD-REFUSED in production. Leave unset (off) unless you know you need it locally.
# RUNNER_ALLOW_HOST_EXEC=1

# ---------- Scrapers (optional — off by default) ----------
# GITHUB_AUTO=false
# HACKERRANK_AUTO=false
# LEETCODE_AUTO=false
# STACKOVERFLOW_AUTO=false
# SCRAPING_SCHEDULER_ENABLED=false
# SCRAPING_SECRET=                                # secret
# LEETCODE_SESSION=                               # secret
# LEETCODE_CSRF=                                  # secret

# ---------- Firehose retention (optional — off by default, Wave 2 / Phase 2.4) ----------
# Opt-in reaper that batch-deletes aged rows from firehose tables (analytics, telemetry,
# audit/comm logs, expired tokens/sessions). Per-table windows live in retention.service.ts.
# RETENTION_ENABLED=false
# RETENTION_CRON=15 3 * * *

# ---------- Internal service tokens (REQUIRED — rotated in Wave 1 / Phase 1.1) ----------
# High-entropy random strings we mint ourselves (not provider keys). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Each value must MATCH on every peer service that uses it:
#   BACKEND_INTERNAL_TOKEN -> document-validator-service/.env (inbound webhook back to backend)
#   INTERNAL_SERVICE_KEY   -> the matching-AI service that receives backend calls (X-Service-Key)
#   INTERNAL_API_TOKEN     -> ai-service, assessment-ai-service, document-validator-service,
#                             job-creation-ai (sent as X-API-Token on backend→Python calls)
BACKEND_INTERNAL_TOKEN=CHANGE_ME                 # secret
INTERNAL_SERVICE_KEY=CHANGE_ME                   # secret
INTERNAL_API_TOKEN=CHANGE_ME                     # secret — must match INTERNAL_API_TOKEN on the Python services
# WAFAA_BASE_URL=
# WAFAA_API_KEY=
# IHSSANE_BASE_URL=
# IHSSANE_API_KEY=
# YOUSSRRA_WEBHOOK_KEY=

# ---------- TTS (optional) ----------
# UNREAL_SPEECH_API_KEY=                          # secret
# UNREAL_SPEECH_VOICE_ID=

# ---------- Payments · Stripe (Wave 5) ----------
# Test-mode keys for pre-prod; real card testing NEVER in staging. Server-side only —
# these must NEVER reach the client bundle.
STRIPE_SECRET_KEY=                                # secret — sk_test_... (checkout, Wave 5 S1)
STRIPE_WEBHOOK_SECRET=                            # secret — whsec_... (webhook signature verify, Wave 5 S2)
