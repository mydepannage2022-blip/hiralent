generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIInterviewResult {
  interview_id   String         @id
  application_id String         @unique
  interview_type String
  score          String?
  video_url      String?
  feedback       String?
  created_at     DateTime       @default(now())
  updated_at     DateTime
  candidate_id   String
  JobApplication JobApplication @relation(fields: [application_id], references: [application_id])
  User           User           @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
}

model AdminAuditLog {
  log_id       String   @id
  admin_id     String
  action_type  String
  target_table String
  target_id    String
  description  String?
  created_at   DateTime @default(now())
  User         User     @relation(fields: [admin_id], references: [user_id], onDelete: Cascade)
}

model Agency {
  agency_id                  String                       @id
  name                       String
  billing_contact_email      String
  owner_user_id              String
  status                     String
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime
  approval_notes             String?
  approved_at                DateTime?
  approved_by                String?
  logo_url                   String?
  website                    String?
  accreditations             String[]
  average_case_duration      Int?
  languages_supported        String[]
  license_expiry             DateTime?
  license_number             String?
  operating_countries        String[]
  rating                     Float?
  service_categories         String[]
  service_description        String?
  success_rate               Float?
  total_cases_handled        Int?
  AgencySubscription         AgencySubscription?
  CompanyJob                 CompanyJob[]
  User                       User[]
  WebhookEndpoint            WebhookEndpoint[]
  agency_reviews             agency_reviews[]
  case_assignments           case_assignments[]
  company_agency_invitations company_agency_invitations[]
  relocation_analytics       relocation_analytics[]
  relocation_cases           relocation_cases[]
}

model AgencyAdminProfile {
  admin_id         String   @id
  phone_number     String?
  position         String?
  linkedin_url     String?
  company_role     String?
  branding_notes   String?
  created_at       DateTime @default(now())
  updated_at       DateTime
  certifications   String[]
  languages        String[]
  license_details  String?
  specialization   String[]
  years_experience Int?
  User             User     @relation(fields: [admin_id], references: [user_id], onDelete: Cascade)
}

model AgencySubscription {
  agency_subscription_id String           @id
  agency_id              String           @unique
  plan_id                String
  stripe_subscription_id String
  status                 String
  current_period_start   DateTime
  current_period_end     DateTime
  trial_ends_at          DateTime?
  created_at             DateTime         @default(now())
  updated_at             DateTime
  Agency                 Agency           @relation(fields: [agency_id], references: [agency_id])
  SubscriptionPlan       SubscriptionPlan @relation(fields: [plan_id], references: [plan_id])
}

model AgencyVerification {
  verification_id        String                 @id
  agency_id              String
  license_status         String
  verification_documents Json
  verified_by            String?
  verification_date      DateTime?
  latest_run_id          String?                @unique
  reason_codes           String[]               @default([])
  risk_score             Float?
  status                 VerificationCaseStatus @default(DRAFT)
  VerificationRun        VerificationRun?       @relation(fields: [latest_run_id], references: [run_id])

  @@index([agency_id])
  @@index([status])
}

model CandidateDocument {
  document_id       String            @id
  candidate_id      String
  file_name         String
  file_path         String
  file_type         String
  file_size         Int
  upload_status     String
  extraction_status String?
  processed_text    String?
  created_at        DateTime          @default(now())
  updated_at        DateTime
  User              User              @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
  CandidateSkill    CandidateSkill[]
  SkillExtraction   SkillExtraction[]
}

model CandidateProfile {
  candidate_id           String   @id
  resume_url             String?
  video_intro_url        String?
  education              String?
  experience             String?
  preferred_locations    String?
  languages              String?
  created_at             DateTime @default(now())
  updated_at             DateTime
  location               String?
  minimum_salary_amount  Float?
  postal_code            Int?
  payment_period         String?
  profile_picture_url    String?
  headline               String?  @db.VarChar(120)
  about_me               String?  @db.VarChar(500)
  city                   String?
  job_benefits           String?
  links                  String?
  skills                 String[]
  resume_application_url String?
  User                   User     @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
}

model CandidateProgressTracker {
  progress_id                                      String     @id
  candidate_id                                     String
  job_id                                           String
  stage                                            String
  updated_by                                       String
  notes                                            String?
  updated_at                                       DateTime   @default(now())
  User_CandidateProgressTracker_candidate_idToUser User       @relation("CandidateProgressTracker_candidate_idToUser", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  CompanyJob                                       CompanyJob @relation(fields: [job_id], references: [job_id])
  User_CandidateProgressTracker_updated_byToUser   User       @relation("CandidateProgressTracker_updated_byToUser", fields: [updated_by], references: [user_id], onDelete: Cascade)
}

model CandidateSkill {
  skill_id           String             @id
  candidate_id       String
  skill_name         String
  skill_category     String?
  proficiency        String?
  years_experience   Int?
  confidence_score   Float?
  source_type        String
  source_document_id String?
  is_verified        Boolean            @default(false)
  created_at         DateTime           @default(now())
  updated_at         DateTime
  User               User               @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
  CandidateDocument  CandidateDocument? @relation(fields: [source_document_id], references: [document_id])
}

model CandidateVector {
  vector_id         String   @id
  candidate_id      String   @unique
  skill_vector      Json
  experience_vector Json
  education_vector  Json
  combined_vector   Json
  vector_version    String
  last_updated      DateTime @default(now())
  created_at        DateTime @default(now())
  User              User     @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
}

model CareerPrediction {
  prediction_id      String   @id
  candidate_id       String
  current_role       String?
  predicted_roles    Json
  career_path        Json
  skill_gaps         Json
  salary_prediction  Json
  confidence_score   Float
  ai_model_version   String
  input_data_summary String?
  created_at         DateTime @default(now())
  updated_at         DateTime
  User               User     @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
}

model CompanyJob {
  job_id                   String                     @id
  company_id               String
  agency_id                String?
  title                    String
  location                 String
  description              String
  salary_range             String?
  required_skills          String?
  status          JobStatus @default(DRAFT)   
  job_type                 String?
  experience_level         String?
  education_level          String?
  remote_option            String?
  visa_sponsored           Boolean?
  relocation_assistance    Boolean?
  urgency_level            String?
  department               String?
  reporting_to             String?
  team_size                Int?
  application_deadline     DateTime?
  max_applications         Int?
  auto_reject_after        Int?
  screening_questions      String[]
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  CandidateProgressTracker CandidateProgressTracker[]
  Agency                   Agency?                    @relation(fields: [agency_id], references: [agency_id])
  User                     User                       @relation(fields: [company_id], references: [user_id], onDelete: Cascade)
  JobApplication           JobApplication[]
  JobRecommendation        JobRecommendation[]
  JobVector                JobVector?
  interview_schedules      interview_schedules[]
  relocation_cases         relocation_cases[]
  skill_assessments        skill_assessments[]
   // ADD THIS RELATION:
  employerAssessments EmployerAssessment[] @relation("JobAssessments")
}

model CompanyProfile {
  company_id                String    @id
  company_name              String?
  display_name              String?
  industry                  String?
  company_size              String?
  website                   String?
  headquarters              String?
  founded_year              Int?
  description               String?
  contact_number            String?
  linkedin_profile          String?
  twitter_handle            String?
  facebook_page             String?
  business_type             String?
  registration_number       String?
  tax_id                    String?
  employee_count            Int?
  annual_revenue            String?
  hiring_volume             String?
  typical_roles             String[]
  hiring_regions            String[]
  remote_policy             String?
  logo_url                  String?
  banner_url                String?
  verified                  Boolean   @default(false)
  verification_date         DateTime?
  rating                    Float?
  total_jobs_posted         Int?
  active_jobs_count         Int?
  created_at                DateTime  @default(now())
  updated_at                DateTime
  full_address              String?
  verification_notes        String?
  verification_status       String?   @default("unverified")
  verification_submitted_at DateTime?
  User                      User      @relation(fields: [company_id], references: [user_id])
}

model CompanyVerification {
  verification_id   String                 @id
  company_id        String
  documents         Json
  verified_by       String?
  verification_date DateTime?
  latest_run_id     String?                @unique
  reason_codes      String[]               @default([])
  risk_score        Float?
  status            VerificationCaseStatus @default(DRAFT)
  VerificationRun   VerificationRun?       @relation(fields: [latest_run_id], references: [run_id])

  @@index([company_id])
  @@index([status])
}

model JobApplication {
  application_id      String                @id
  candidate_id        String
  job_id              String
  status              String
  cover_letter        String?
  applied_at          DateTime              @default(now())
  updated_at          DateTime
  assessment_score    Float?
  available_from      DateTime?
  current_location    String?
  interview_feedback  String?
  rejection_reason    String?
  salary_expectation  Float?
  screening_answers   Json?
  visa_status         String?
  willing_to_relocate Boolean?
  AIInterviewResult   AIInterviewResult?
  User                User                  @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
  CompanyJob          CompanyJob            @relation(fields: [job_id], references: [job_id])
  interview_schedules interview_schedules[]
}

model JobRecommendation {
  recommendation_id String     @id
  candidate_id      String
  job_id            String
  match_score       Float
  skill_match       Json
  salary_match      Float?
  location_match    Float?
  experience_match  Float?
  ai_reasoning      String?
  is_viewed         Boolean    @default(false)
  is_applied        Boolean    @default(false)
  created_at        DateTime   @default(now())
  updated_at        DateTime
  User              User       @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
  CompanyJob        CompanyJob @relation(fields: [job_id], references: [job_id])
}

model JobVector {
  vector_id           String     @id
  job_id              String     @unique
  requirements_vector Json
  skills_vector       Json
  combined_vector     Json
  vector_version      String
  last_updated        DateTime   @default(now())
  created_at          DateTime   @default(now())
  CompanyJob          CompanyJob @relation(fields: [job_id], references: [job_id])
}

model Notification {
  notification_id String   @id
  user_id         String
  type            String
  message         String
  is_read         Boolean  @default(false)
  sent_via        String
  created_at      DateTime @default(now())
  User            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model ProfileCompleteness {
  completeness_id       String   @id
  candidate_id          String   @unique
  overall_score         Float
  basic_info_score      Float
  skills_score          Float
  experience_score      Float
  education_score       Float
  document_score        Float
  missing_fields        Json
  suggestions           Json
  last_calculated       DateTime @default(now())
  created_at            DateTime @default(now())
  profile_picture_score Float
  headline_score        Float    @default(0.0)
  User                  User     @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
}

model RolePermission {
  permission_id String      @id
  role_name     String
  module        String
  created_at    DateTime    @default(now())
  updated_at    DateTime
  access_level  AccessLevel
}

model SkillExtraction {
  extraction_id     String            @id
  document_id       String
  candidate_id      String
  status            String
  ai_provider       String
  prompt_used       String?
  raw_response      String?
  extracted_skills  Json?
  processing_time   Int?
  error_message     String?
  created_at        DateTime          @default(now())
  updated_at        DateTime
  User              User              @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
  CandidateDocument CandidateDocument @relation(fields: [document_id], references: [document_id])
}

model SubscriptionPlan {
  plan_id                  String               @id
  name                     String
  price_monthly_usd        Decimal
  price_annually_usd       Decimal
  job_post_limit           Int
  ai_interview_limit       Int
  features_included        String
  is_publicly_available    Boolean
  stripe_price_id_monthly  String
  stripe_price_id_annually String
  created_at               DateTime             @default(now())
  updated_at               DateTime
  AgencySubscription       AgencySubscription[]
}

model SuperAdmin {
  admin_id    String   @id
  user_id     String
  permissions String[]
  created_at  DateTime @default(now())
}

model UploadedDocument {
  document_id   String   @id
  uploaded_by   String
  subject_type  String
  subject_id    String
  file_name     String
  storage_key   String
  url           String?
  mime_type     String
  file_ext      String?
  file_size     Int
  sha256        String
  document_type String
  status        String   @default("pending")
  notes         String?
  preview_key   String?
  preview_ready Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime
  User          User     @relation(fields: [uploaded_by], references: [user_id], onDelete: Cascade)

  @@index([document_type])
  @@index([subject_type, subject_id])
  @@index([uploaded_by])
}

model User {
  user_id                                                              String                       @id
  agency_id                                                            String?
  email                                                                String                       @unique
  password_hash                                                        String
  full_name                                                            String
  role                                                                 String
  is_email_verified                                                    Boolean
  created_at                                                           DateTime                     @default(now())
  updated_at                                                           DateTime
  last_login_at                                                        DateTime?
  branding_notes                                                       String?
  company_role                                                         String?
  linkedin_url                                                         String?
  phone_number                                                         String?
  position                                                             String?
  mfa_enabled                                                          Boolean                      @default(false)
  mfa_secret                                                           String?
  AIInterviewResult                                                    AIInterviewResult[]
  AdminAuditLog                                                        AdminAuditLog[]
  AgencyAdminProfile                                                   AgencyAdminProfile?
  CandidateDocument                                                    CandidateDocument[]
  CandidateProfile                                                     CandidateProfile?
  CandidateProgressTracker_CandidateProgressTracker_candidate_idToUser CandidateProgressTracker[]   @relation("CandidateProgressTracker_candidate_idToUser")
  CandidateProgressTracker_CandidateProgressTracker_updated_byToUser   CandidateProgressTracker[]   @relation("CandidateProgressTracker_updated_byToUser")
  CandidateSkill                                                       CandidateSkill[]
  CandidateVector                                                      CandidateVector?
  CareerPrediction                                                     CareerPrediction[]
  CompanyJob                                                           CompanyJob[]
  CompanyProfile                                                       CompanyProfile?
  JobApplication                                                       JobApplication[]
  JobRecommendation                                                    JobRecommendation[]
  Notification                                                         Notification[]
  ProfileCompleteness                                                  ProfileCompleteness?
  SkillExtraction                                                      SkillExtraction[]
  UploadedDocument                                                     UploadedDocument[]
  Agency                                                               Agency?                      @relation(fields: [agency_id], references: [agency_id])
  agency_reviews                                                       agency_reviews[]
  ai_feedback                                                          ai_feedback[]
  case_assignments                                                     case_assignments[]
  communication_logs_communication_logs_recipient_idToUser             communication_logs[]         @relation("communication_logs_recipient_idToUser")
  communication_logs_communication_logs_sender_idToUser                communication_logs[]         @relation("communication_logs_sender_idToUser")
  company_agency_invitations                                           company_agency_invitations[]
  generated_content                                                    generated_content[]
  hiring_analytics                                                     hiring_analytics[]
  relocation_cases                                                     relocation_cases[]
  skill_assessments                                                    skill_assessments[]
  usage_analytics                                                      usage_analytics[]
  user_sessions                                                        user_sessions[]
  // ADD THESE NEW RELATIONS:
  employerAssessments EmployerAssessment[] @relation("CompanyAssessments")
  conversations_p1    Conversation[]       @relation("ConversationP1")
  conversations_p2    Conversation[]       @relation("ConversationP2")
  sent_messages       Message[]            @relation("UserMessages")
}

model VerificationRun {
  run_id               String                  @id
  subject_type         VerificationSubjectType
  subject_id           String
  status               VerificationRunStatus
  started_at           DateTime                @default(now())
  ended_at             DateTime?
  risk_score           Float?
  decision             VerificationDecision?
  reason_codes         String[]                @default([])
  AgencyVerification   AgencyVerification?
  CompanyVerification  CompanyVerification?
  VerificationSignal   VerificationSignal[]
  VerificationSnapshot VerificationSnapshot?
}

model VerificationSignal {
  signal_id       String          @id
  run_id          String
  signal_type     String
  passed          Boolean
  score           Float?
  explanation     String?
  raw_payload     Json?
  VerificationRun VerificationRun @relation(fields: [run_id], references: [run_id], onDelete: Cascade)
}

model VerificationSnapshot {
  snapshot_id     String          @id
  run_id          String          @unique
  profile         Json
  documents       Json
  created_at      DateTime        @default(now())
  VerificationRun VerificationRun @relation(fields: [run_id], references: [run_id], onDelete: Cascade)
}

model WebhookEndpoint {
  webhook_id                  String    @id
  agency_id                   String
  url                         String
  secret_key                  String
  subscribed_event_types      String
  status                      String
  last_successful_delivery_at DateTime?
  last_failed_delivery_at     DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime
  Agency                      Agency    @relation(fields: [agency_id], references: [agency_id])
}

model agency_reviews {
  review_id    String   @id
  agency_id    String
  reviewer_id  String
  case_id      String?
  rating       Int
  review_text  String?
  service_type String?
  created_at   DateTime @default(now())
  Agency       Agency   @relation(fields: [agency_id], references: [agency_id])
  User         User     @relation(fields: [reviewer_id], references: [user_id], onDelete: Cascade)
}

model ai_feedback {
  feedback_id             String   @id
  user_id                 String
  feature_type            String
  feature_instance_id     String?
  rating                  Int
  feedback_text           String?
  improvement_suggestions String?
  accuracy_rating         Int?
  usefulness_rating       Int?
  speed_rating            Int?
  user_experience_level   String?
  use_case                String?
  would_recommend         Boolean?
  would_use_again         Boolean?
  contact_for_followup    Boolean  @default(false)
  created_at              DateTime @default(now())
  User                    User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model ai_training_data {
  training_id         String   @id
  data_type           String
  source_table        String
  source_id           String
  model_name          String
  training_purpose    String
  input_data          Json
  expected_output     Json?
  actual_output       Json?
  data_quality_score  Float?
  verified            Boolean  @default(false)
  verified_by         String?
  used_in_training    Boolean  @default(false)
  training_session_id String?
  contribution_score  Float?
  created_at          DateTime @default(now())
  updated_at          DateTime
}

model assessment_results {
  result_id         String            @id
  assessment_id     String
  question_id       String
  question_text     String
  question_type     QuestionType
  expected_answer   String?
  user_answer       String
  is_correct        Boolean?
  partial_score     Float?
  time_taken        Int
  ai_evaluation     Json?
  feedback          String?
  answered_at       DateTime          @default(now())
  skill_assessments skill_assessments @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade)
}

model assessment_summaries {
  summary_id            String            @id
  assessment_id         String            @unique
  overall_score         Float
  skill_level           String
  pass_status           String
  correct_answers       Int
  incorrect_answers     Int
  partial_answers       Int               @default(0)
  total_questions       Int
  accuracy_rate         Float
  total_time_spent      Int
  avg_time_per_question Float
  category_scores       Json?
  difficulty_scores     Json
  strengths             String[]
  weaknesses            String[]
  recommendations       String[]
  next_steps            String[]
  ai_confidence         Float
  achievements          String[]          @default([])
  badges_earned         String[]          @default([])
  created_at            DateTime          @default(now())
  updated_at            DateTime
  skill_assessments     skill_assessments @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade)
}

model business_insights {
   insight_id  String @id @default(uuid())
  target_id   String // company_id, agency_id, or system-wide
  target_type String // company, agency, platform

  // Insight Details
  insight_type      InsightType
  category          InsightCategory
  title             String
  description       String
  detailed_analysis String?

  // AI Details
  ai_model   String // Which AI model generated this
  confidence Float? // 0-1 confidence score (now optional)
  evidence   Json? // Supporting data/evidence
  payload    Json? // raw structured JSON from the LLM

  // Actionability
  priority          String   @default("medium") // low, medium, high, critical
  action_required   Boolean  @default(false)
  suggested_actions String[] // Array of suggested actions
  expected_impact   String? // Expected impact if acted upon

  // Status
  status          String    @default("new") // new, viewed, acted_upon, dismissed
  viewed_at       DateTime?
  acted_upon_at   DateTime?
  feedback_rating Int? // 1-5 rating from user
  feedback_text   String?

  // Validity
  expires_at   DateTime? // When this insight becomes stale
  is_recurring Boolean   @default(false)
  next_update  DateTime? // When to regenerate this insight

  // Idempotency / dedupe (NEW)
  /// Date-only bucket; 1 insight max per (company, category, day)
  day_bucket      DateTime @default(dbgenerated("CURRENT_DATE"))
  /// Optional stronger guard (hash of companyId|category|YYYY-MM-DD|content)
  dedupe_checksum String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([target_type, target_id, category, day_bucket], map: "insight_daily_unique")
  @@index([target_type, target_id])
  @@index([dedupe_checksum])
  @@map("business_insights")
}

model case_assignments {
  assignment_id    String           @id
  case_id          String
  agent_id         String
  assigned_at      DateTime         @default(now())
  status           String
  notes            String?
  agency_id        String
  Agency           Agency           @relation(fields: [agency_id], references: [agency_id])
  User             User             @relation(fields: [agent_id], references: [user_id], onDelete: Cascade)
  relocation_cases relocation_cases @relation(fields: [case_id], references: [case_id])
}

model case_documents {
  document_id      String           @id
  case_id          String
  file_name        String
  file_path        String
  file_type        String
  file_size        Int
  document_type    String
  uploaded_by      String
  status           String
  notes            String?
  created_at       DateTime         @default(now())
  relocation_cases relocation_cases @relation(fields: [case_id], references: [case_id])
}

model case_progress_updates {
  update_id        String           @id
  case_id          String
  updated_by       String
  status           String
  description      String
  is_milestone     Boolean          @default(false)
  created_at       DateTime         @default(now())
  relocation_cases relocation_cases @relation(fields: [case_id], references: [case_id])
}

model communication_logs {
  log_id                                     String    @id
  sender_id                                  String
  recipient_id                               String
  message_type                               String
  channel                                    String?
  subject                                    String?
  content                                    String
  content_type                               String    @default("text")
  ai_generated                               Boolean   @default(false)
  ai_model_used                              String?
  status                                     String
  sent_at                                    DateTime?
  delivered_at                               DateTime?
  read_at                                    DateTime?
  failed_reason                              String?
  related_entity_type                        String?
