model AdminAuditLog {
  log_id       String   @id @default(uuid())
  // Nullable + SetNull (was required + Cascade): an audit log is a security record and must
  // OUTLIVE the admin it references. Cascade deleted an admin's own past actions when that admin
  // was removed — destroying exactly the trail the Security Log page exists to preserve. On admin
  // delete, admin_id is now nulled and the row survives; the API/UI already render admin=null as "—".
  admin_id     String?
  action_type  String
  target_table String
  target_id    String
  description  String?
  created_at   DateTime @default(now())
  admin        User?    @relation(fields: [admin_id], references: [user_id], onDelete: SetNull)

  @@index([admin_id, created_at])
  @@index([target_table, target_id])
  @@index([created_at])
}

