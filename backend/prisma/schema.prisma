// ============================================
// PAYMENT & SUBSCRIPTION MODELS (NEW)
// ============================================

model UserSubscription {
  subscription_id          String   @id @default(uuid())
  user_id                  String   @unique
  plan_id                  String
  payment_gateway          String   // stripe, paypal, manual
  gateway_subscription_id  String?  // External subscription ID
  status                   String   @default("active") // active, canceled, expired, past_due, trialing
  billing_cycle            String   // monthly, yearly
  current_period_start     DateTime
  current_period_end       DateTime
  trial_ends_at            DateTime?
  cancel_at_period_end     Boolean  @default(false)
  canceled_at              DateTime?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  // Relations
  user         User                  @relation("UserSubscriptions", fields: [user_id], references: [user_id], onDelete: Cascade)
  plan         SubscriptionPlan      @relation("SubscriptionPlanToUser", fields: [plan_id], references: [plan_id])
  transactions PaymentTransaction[]  @relation("SubscriptionTransactions")

  @@index([user_id])
  @@index([status])
  @@index([current_period_end])
}

model PaymentTransaction {
  transaction_id       String    @id @default(uuid())
  user_id              String
  subscription_id      String?
  amount               Decimal   @db.Decimal(10, 2)
  currency             String    @default("USD") // USD, AED, SAR, etc.
  payment_gateway      String    // stripe, paypal, razorpay, paytabs, manual
  gateway_payment_id   String?   // External payment ID
  gateway_customer_id  String?   // External customer ID
  status               String    @default("pending") // pending, processing, succeeded, failed, canceled, refunded
  payment_method       String?   // card, paypal, bank_transfer, etc.
  failure_reason       String?
  metadata             Json?     // Additional data
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  // Relations
  user         User              @relation("UserPayments", fields: [user_id], references: [user_id], onDelete: Cascade)
  subscription UserSubscription? @relation("SubscriptionTransactions", fields: [subscription_id], references: [subscription_id])

  @@index([user_id])
  @@index([subscription_id])
  @@index([status])
  @@index([gateway_payment_id])
}

model EmbassySubmission {
  submission_id       String    @id @default(uuid())
  case_id             String    @unique
  embassy_name        String
  embassy_location    String
  submission_date     DateTime
  tracking_number     String?
  expected_response   DateTime?
  receipt_url         String?
  status              String    @default("submitted")
  interview_date      DateTime?
  interview_location  String?
  interview_notes     String?
  decision_date       DateTime?
  decision_notes      String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  
  case                RelocationCase @relation(fields: [case_id], references: [case_id])

  @@map("embassy_submissions")
}

// Scraping candidates (Models + enums)

enum SourcedCandidateStatus {
  NEW
  ACTIVE
  HIDDEN
  CONVERTED
}

model SourcedCandidate {
  sourced_candidate_id String   @id @default(uuid())

  // Where it came from
  source              String   // "greenhouse" | "lever" | "csv" | "github" | ...
  source_uid          String?  // id from the source if available
  source_profile_url  String?  // link to profile page
  source_run_id       String?  // last run that touched this record

  // Normalized profile fields (employer-facing)
  full_name   String?
  headline    String?
  about_me    String?  @db.VarChar(800)
  location    String?
  city        String?
  skills      String[] @default([])
  links       Json?    // store as JSON instead of String (much better)
  
  // Optional contact fields (might exist for ATS/CSV)
  email       String?
  phone       String?
  linkedin_url String?

  // Dedupe + search helpers
  fingerprint String  @unique  // computed hash (see below)
  status      SourcedCandidateStatus @default(NEW)

  // Conversion: if candidate later becomes a real platform user
  user_id     String? @unique
  user        User?   @relation("SourcedCandidateToUser", fields: [user_id], references: [user_id], onDelete: SetNull)

  runItems SourcingRunItem[] @relation("RunItemToSourcedCandidate")


  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([source])
  @@index([email])
  @@index([linkedin_url])
}

enum SourcingRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model SourcingRun {
  run_id      String   @id @default(uuid())
  status      SourcingRunStatus @default(QUEUED)

  triggered_by_user_id String?
  triggered_by User? @relation("SourcingRunTriggeredByUser", fields: [triggered_by_user_id], references: [user_id], onDelete: SetNull)


  sources     String[]  // ["greenhouse","lever"]
  query       String?
  filters     Json?
  started_at  DateTime @default(now())
  ended_at    DateTime?

  total_found Int @default(0)
  total_saved Int @default(0)
  total_skipped Int @default(0)
  error       String?

  items       SourcingRunItem[]

  @@index([status])
}

model SourcingRunItem {
  item_id    String @id @default(uuid())
  run_id     String
  run        SourcingRun @relation(fields: [run_id], references: [run_id], onDelete: Cascade)

  sourced_candidate_id String?
  sourcedCandidate SourcedCandidate? @relation("RunItemToSourcedCandidate", fields: [sourced_candidate_id], references: [sourced_candidate_id], onDelete: SetNull)


  source     String
  source_uid String?
  action     String // "created" | "updated" | "skipped" | "failed"
  reason     String?
  raw        Json?  // optional: store raw payload (careful with size)

  created_at DateTime @default(now())

  @@index([run_id])
}
