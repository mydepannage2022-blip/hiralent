  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  
  candidate        User              @relation("AutofillSessions", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  document         CandidateDocument @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  mappings         AutofillFieldMapping[]
  
  @@index([candidate_id])
  @@index([status])
}

model AutofillFieldMapping {
  mapping_id       String   @id @default(uuid())
  session_id       String
  field_name       String
  extracted_value  Json
  confidence       Float
  is_confirmed     Boolean  @default(false)
  confirmed_value  Json?
  created_at       DateTime @default(now())
  
  session          ResumeAutofillSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
}

// Scoring System
model CandidateScore {
  score_id            String   @id @default(uuid())
  candidate_id        String   @unique
  total_score         Float    @default(0)
  skills_score        Float    @default(0)
  experience_score    Float    @default(0)
  education_score     Float    @default(0)
  completeness_score  Float    @default(0)
  last_calculated     DateTime @updatedAt
  calculation_method  String   @default("v1")
  created_at          DateTime @default(now())
  
  candidate           User     @relation("CandidateScore", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  history             ScoreHistory[]
  
  @@index([total_score])
}

model ScoreHistory {
  history_id       String   @id @default(uuid())
  score_id         String
  score_value      Float
  trigger_event    String
  timestamp        DateTime @default(now())
  
  candidateScore   CandidateScore @relation(fields: [score_id], references: [score_id], onDelete: Cascade)
  
  @@index([score_id])
  @@index([timestamp])
}

// Badge System
model Badge {
  badge_id     String   @id @default(uuid())
  name         String   @unique
  description  String
  icon         String
  category     String
  rule_id      String   @unique
  criteria     Json
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  
  awards       BadgeAward[]
}


model BadgeAward {
  award_id     String   @id @default(uuid())
  candidate_id String
  badge_id     String
  awarded_at   DateTime @default(now())
  revoked_at   DateTime?
  is_active    Boolean  @default(true)
  
  candidate    User     @relation("CandidateBadges", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  badge        Badge    @relation(fields: [badge_id], references: [badge_id], onDelete: Restrict)
  
  @@unique([candidate_id, badge_id])
  @@index([candidate_id])
  @@index([is_active])
}

// Certification System
model Certification {
  certification_id String   @id @default(uuid())
  candidate_id     String
  name             String
  issuer           String
  issue_date       DateTime?   //  make optional

  expiry_date      DateTime?
  credential_id    String?
  credential_url   String?
  is_verified      Boolean  @default(false)
  verification_source String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  
  candidate        User     @relation("CandidateCertifications", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  
  @@index([candidate_id])
  @@index([expiry_date])
}

// Event System
model ProfileEvent {
  event_id     String   @id @default(uuid())
  candidate_id String
  event_type   String
  event_data   Json
  timestamp    DateTime @default(now())
  
  candidate    User     @relation("ProfileEvents", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  
  @@index([candidate_id])
  @@index([event_type])
  @@index([timestamp])
}

//Global template layer (enums + models)

enum AssessmentTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentTemplateProvider {
  INTERNAL      // curated by you/admins
  HACKERRANK    // imported style / mimicked
  CUSTOM        // optional (created by company then saved as template later)
}

model AssessmentTemplate {
  template_id      String                    @id @default(uuid())

  title            String
  description      String

  // Same “metadata” you want to filter by
  assessment_type  AssessmentType
  skill_category   String
  difficulty       DifficultyLevel
  time_limit       Int                       @default(60)
  total_questions  Int                       @default(20)
  passing_score    Int?                      @default(70)

  // For filtering/search
  extracted_skills String[]                  @default([])
  tags             String[]                  @default([])

  // Optional advanced fields
  settings         Json?
  enhanced_data    Json?
  provider         AssessmentTemplateProvider @default(INTERNAL)
  status           AssessmentTemplateStatus   @default(DRAFT)

  // Audit
  created_by       String?   // user_id (admin/system)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // Relations
  questions        AssessmentTemplateQuestion[]
  creator User? @relation("UserAssessmentTemplatesCreated", fields: [created_by], references: [user_id], onDelete: SetNull)
  employerAssessments EmployerAssessment[] @relation("EmployerAssessmentTemplate")

  @@index([status])
  @@index([provider])
  @@index([difficulty])
  @@map("assessment_templates")
}

model AssessmentTemplateQuestion {
  id           String   @id @default(uuid())
  template_id  String
  question_id  String

  // Optional metadata (same spirit as AssessmentQuestion)
  order        Int?
  points       Int      @default(1)
  section      String?
  isReserve    Boolean  @default(false)

  template AssessmentTemplate @relation(fields: [template_id], references: [template_id], onDelete: Cascade)
  question  Question          @relation(fields: [question_id], references: [id], onDelete: Restrict)

  @@unique([template_id, question_id])
  @@index([template_id])
  @@index([question_id])

  @@map("assessment_template_questions")
}

model ChatConversation {
  conversation_id String   @id @default(uuid())
  candidate_id    String
  title           String   @default("New chat")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  last_message_at DateTime @default(now())
  is_archived     Boolean  @default(false)

  candidate User @relation("CandidateChatConversations", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([candidate_id, last_message_at])
  @@map("chat_conversations")
}

model ChatMessage {
  message_id      String   @id @default(uuid())
  conversation_id String
  role            String   // "user" | "assistant"
  content         String   @db.Text
  created_at      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("chat_messages")
}

// ==================== COMPANY TEAM ENUMS ====================

enum CompanyTeamRole {
  owner
  admin
  hr_manager
  recruiter
  viewer
}

enum InvitationStatus {
  pending
  accepted
  expired
  cancelled
}

enum CompanyModule {
  dashboard
  jobs
  candidates
  assessments
  questions
  messages
  settings
  team
  analytics
  billing
}

// ==================== COMPANY TEAM MODELS ====================

model CompanyTeamMember {
  member_id     String          @id @default(uuid())
  company_id    String
  user_id       String
  role          CompanyTeamRole @default(recruiter)
  job_title     String?
  department    String?
  is_active     Boolean         @default(true)
  invited_by    String?
  joined_at     DateTime        @default(now())
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  // Relations
  company       User            @relation("CompanyTeamMembers", fields: [company_id], references: [user_id], onDelete: Cascade)
  user          User            @relation("UserTeamMemberships", fields: [user_id], references: [user_id], onDelete: Cascade)
  inviter       User?           @relation("TeamMemberInviter", fields: [invited_by], references: [user_id], onDelete: SetNull)
  permissions   CompanyMemberPermission[]
  activityLogs  CompanyActivityLog[]

  @@unique([company_id, user_id])
  @@index([company_id])
  @@index([user_id])
  @@index([role])
}

model CompanyTeamInvitation {
  invitation_id      String           @id @default(uuid())
  company_id         String
  email              String
  role               CompanyTeamRole  @default(recruiter)
  job_title          String?
  department         String?
  token              String           @unique
  token_hash         String
  status             InvitationStatus @default(pending)
  invited_by         String?
  expires_at         DateTime
  accepted_at        DateTime?
  cancelled_at       DateTime?
  custom_permissions Json?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  // Relations
  company    User @relation("CompanyInvitations", fields: [company_id], references: [user_id], onDelete: Cascade)
  inviter    User? @relation("SentInvitations", fields: [invited_by], references: [user_id], onDelete: SetNull)

  @@index([company_id])
  @@index([email])
  @@index([token])
  @@index([status])
}

model CompanyMemberPermission {
  permission_id String        @id @default(uuid())
  member_id     String
  module        CompanyModule
  can_view      Boolean       @default(false)
  can_create    Boolean       @default(false)
  can_edit      Boolean       @default(false)
  can_delete    Boolean       @default(false)
  can_manage    Boolean       @default(false)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  // Relations
  member CompanyTeamMember @relation(fields: [member_id], references: [member_id], onDelete: Cascade)

  @@unique([member_id, module])
  @@index([member_id])
  @@index([module])
}

model CompanyActivityLog {
  log_id          String    @id @default(uuid())
  company_id      String
  member_id       String?
  user_id         String?
  action          String
  action_category String
  resource_type   String?
  resource_id     String?
  resource_name   String?
  details         Json?
  ip_address      String?
  user_agent      String?
  created_at      DateTime  @default(now())

  // Relations
  company User               @relation("CompanyActivityLogs", fields: [company_id], references: [user_id], onDelete: Cascade)
  member  CompanyTeamMember? @relation(fields: [member_id], references: [member_id], onDelete: SetNull)
  actor   User?              @relation("ActivityActor", fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([company_id])
  @@index([member_id])
  @@index([user_id])
  @@index([action])
  @@index([action_category])
  @@index([created_at])
}

//Candidate Space Test enums + Models

enum AssessmentSessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

enum CandidateAnswerState {
  DRAFT
  FINAL
}

enum TelemetryEventType {
  SESSION_START
  SESSION_RESUME
  QUESTION_VIEW
  NAVIGATE
  ANSWER_CHANGED
  FLAG_TOGGLE
  CODE_RUN
  CODE_SUBMIT
  FOCUS_LOST
  COPY_PASTE
  TAB_SWITCH
  FULLSCREEN_EXIT
  NETWORK_ISSUE
  AUTO_SUBMIT
  SUBMIT
}

model CandidateAssessmentSession {
  session_id     String                 @id @default(uuid())
  assessment_id  String                 // EmployerAssessment.assessment_id
  candidate_id   String                 // User.user_id

  status         AssessmentSessionStatus @default(IN_PROGRESS)
  submission_reason String?  // "USER_SUBMIT" | "AUTO_SUBMIT" | "TIME_EXPIRED"

  // timing
  started_at     DateTime               @default(now())
  last_activity_at DateTime             @default(now())
  submitted_at   DateTime?
  expires_at     DateTime?              // started_at + time_limit (optional but useful)
  time_limit_min Int?                   // snapshot from EmployerAssessment.time_limit

  // navigation / UX state
  current_index  Int                    @default(0)
  flagged        String[]               @default([]) // question_id(s)
  progress       Json?                  // optional: computed snapshot for fast resume

  // scoring snapshot (Track D feed)
  total_score    Float?
  passed         Boolean?
  result_summary Json?                  // radar/evidence summary prepared by worker

  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt

  // relations
  assessment     EmployerAssessment      @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade)
  candidate      User                   @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)

  answers        CandidateAssessmentAnswer[]
  telemetry      CandidateAssessmentTelemetryEvent[]
  insight        CandidateAssessmentInsight?

  @@unique([assessment_id, candidate_id], map: "uniq_candidate_session_per_assessment")
  @@index([candidate_id, status])
  @@index([assessment_id, status])
  @@map("candidate_assessment_sessions")
}

model CandidateAssessmentAnswer {
  answer_id     String              @id @default(uuid())
  session_id    String
  question_id   String              // Question.id

  state         CandidateAnswerState @default(DRAFT)

  // generic answer payload (MCQ/CODING)
  answer        Json?               // { selectedOptionIds:[], code:"", language:"", ... }

  // helpful metrics
  time_spent_sec Int?               // aggregated time on question
  attempts       Int                @default(0) // for coding runs
  last_error     String?
  last_saved_at  DateTime           @default(now())

  // link to runner submissions (optional)
  latest_submission_id String?      // CodeSubmission.submission_id (not enforced as FK to avoid tight coupling)

  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt

  session       CandidateAssessmentSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  question      Question                 @relation(fields: [question_id], references: [id], onDelete: Restrict)

  @@unique([session_id, question_id], map: "uniq_answer_per_question_per_session")
  @@index([session_id])
  @@index([question_id])
  @@map("candidate_assessment_answers")
}

model CandidateAssessmentTelemetryEvent {
  event_id     String            @id @default(uuid())
  session_id   String
  candidate_id String

  type         TelemetryEventType
  payload      Json?             // metadata (questionId, duration, etc.)
  created_at   DateTime          @default(now())

  session      CandidateAssessmentSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  candidate    User                     @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)

  @@index([session_id, created_at])
  @@index([candidate_id, created_at])
  @@index([type])
  @@map("candidate_assessment_telemetry")
}

model CandidateAssessmentInsight {
  insight_id   String   @id @default(uuid())
  session_id   String   @unique

  // AI output
  strengths        Json?
  weaknesses       Json?
  recommendations  Json?
  risk_flags       Json?  // { level, reasons, evidenceQuestionIds:[] }

  evidence_by_skill Json? // { "React":[{questionId, note}], "SQL":[...] }

  // ✅ NEW: Gemini agent outputs (for company UI)
  radar_ai   Json?   // [{ label, score, evidenceQuestionIds, note }]
  kpis       Json?   // { overallScore, reliability, riskLevel, ... }
  summary    String? // 2–4 lines recruiter-friendly

  model_name   String?
  model_version String?
  confidence   Float?
  generated_at DateTime @default(now())

  session      CandidateAssessmentSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@map("candidate_assessment_insights")
}


//Simple test models (1 test per job, many invites/attempts)
enum SimpleTestInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SimpleTestAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum SimpleTestQuestionKind {
  MCQ
  CODING
}

model JobSimpleTest {
  test_id        String   @id @default(uuid())
  job_id         String   @unique
  company_id     String

  title          String
  description    String?
  time_limit_min Int      @default(10)


  // NEW: system-managed flags
  is_system      Boolean  @default(true)
  version        Int      @default(1)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  job            CompanyJob @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  company        User       @relation("CompanyJobSimpleTests", fields: [company_id], references: [user_id], onDelete: Cascade)

  questions      JobSimpleTestQuestion[]   // ✅ NEW
  invites        CandidateJobSimpleTestInvite[]
  attempts       CandidateJobSimpleTestAttempt[]

  @@index([company_id])
  @@map("job_simple_tests")
}

model JobSimpleTestQuestion {
  id          String @id @default(uuid())
  test_id     String
  question_id String

  kind        SimpleTestQuestionKind
  order       Int?

  test        JobSimpleTest @relation(fields: [test_id], references: [test_id], onDelete: Cascade)
  question    Question      @relation(fields: [question_id], references: [id], onDelete: Restrict)

  @@unique([test_id, question_id])
  @@index([test_id])
  @@index([question_id])
  @@map("job_simple_test_questions")
}


model CandidateJobSimpleTestInvite {
  invite_id      String @id @default(uuid())

  test_id        String
  job_id String
  job    CompanyJob @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  application_id String @unique
  candidate_id   String
  company_id     String

  status         SimpleTestInviteStatus @default(PENDING)
  expires_at     DateTime
  accepted_at    DateTime?
  declined_at    DateTime?

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  test        JobSimpleTest @relation(fields: [test_id], references: [test_id], onDelete: Cascade)
  application JobApplication @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  candidate User @relation("CandidateSimpleTestInvites", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  company   User @relation("CompanySimpleTestInvites", fields: [company_id], references: [user_id], onDelete: Cascade)

  
  attempts CandidateJobSimpleTestAttempt[]

  @@unique([test_id, candidate_id], map: "uniq_simple_test_invite_per_candidate")
  @@index([candidate_id, status])
  @@index([company_id, status])
  @@index([job_id])
  @@map("candidate_job_simple_test_invites")
}

model CandidateJobSimpleTestAttempt {
  attempt_id   String @id @default(uuid())

  invite_id    String
  test_id      String
  candidate_id String
  job_id       String
  application_id String

  attempt_no   Int @default(1)

  status       SimpleTestAttemptStatus @default(NOT_STARTED)
  started_at   DateTime?
  submitted_at DateTime?
  expires_at   DateTime?
  answers      Json?
  score        Float?
  result_summary Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  invite      CandidateJobSimpleTestInvite @relation(fields: [invite_id], references: [invite_id], onDelete: Cascade)
  test        JobSimpleTest @relation(fields: [test_id], references: [test_id], onDelete: Cascade)
  candidate   User @relation("CandidateSimpleTestAttempts", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  job         CompanyJob @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  application JobApplication @relation(fields: [application_id], references: [application_id], onDelete: Cascade)

  @@unique([application_id, attempt_no], map: "uniq_attempt_no_per_application")
  @@index([candidate_id, status])
  @@index([test_id, status])
  @@index([job_id])
  @@index([invite_id])
  @@index([application_id])

  @@map("candidate_job_simple_test_attempts")
}


//Assessment invite model (deadline + accept flow)
enum CandidateAssessmentInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model CandidateAssessmentInvite {
  invite_id      String @id @default(uuid())

  application_id String
  assessment_id  String
  job_id         String
  company_id     String
  candidate_id   String

  status         CandidateAssessmentInviteStatus @default(PENDING)
  expires_at     DateTime
  accepted_at    DateTime?
  declined_at    DateTime?

  session_id     String?

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  application JobApplication     @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  assessment  EmployerAssessment @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade)
  candidate   User               @relation("CandidateAssessmentInvites", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  company     User               @relation("CompanyAssessmentInvites", fields: [company_id], references: [user_id], onDelete: Cascade)

  // ✅ Autorise plusieurs assessments pour la même application,
  //    mais empêche le doublon "même assessment" sur la même application
  @@unique([application_id, assessment_id], map: "uniq_invite_per_application_assessment")

  @@index([candidate_id, status])
  @@index([company_id, status])
  @@index([application_id])
  @@map("candidate_assessment_invites")
}
