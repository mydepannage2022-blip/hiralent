  session_id String?  @db.VarChar(255)
  user_id    String?  @db.VarChar(255)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([token_hash])
  @@index([expires_at])
  @@map("jwt_blacklist")
}

enum AccessLevel {
  none
  read
  write
  manage
}

enum AssessmentType {
  QUICK_CHECK
  COMPREHENSIVE
  CERTIFICATION
  COMPANY_SPECIFIC
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum QuestionType {
  MCQ
  CODING
  ESSAY
  TRUE_FALSE
  SCENARIO
  SHORT_ANSWER
}

enum VerificationSubjectType {
  COMPANY
  AGENCY
}

enum VerificationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum VerificationDecision {
  APPROVE
  REJECT
  MANUAL_REVIEW
