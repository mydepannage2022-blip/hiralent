generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// new schema
model Agency {
  agency_id             String    @id @default(uuid())
  name                  String
  website               String? // NEW
  billing_contact_email String
  owner_user_id         String
  logo_url              String? // NEW
  status                String
  approved_by           String? // NEW
  approved_at           DateTime? // NEW
  approval_notes        String? // NEW
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  users                User[]
  jobs                 RecruiterJob[]
  subscription         AgencySubscription?
  webhooks             WebhookEndpoint[]
  recruiterInvitations RecruiterInvitation[]
}

model User {
  user_id           String    @id @default(uuid())
  agency_id         String?
  email             String    @unique
  password_hash     String
  full_name         String
  role              String
  is_email_verified Boolean
  phone_number      String? // NEW
  position          String? // NEW
  linkedin_url      String? // NEW
  company_role      String? // NEW
  branding_notes    String? // NEW
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  last_login_at     DateTime?

  agency                   Agency?                    @relation(fields: [agency_id], references: [agency_id])
  candidateProfile         CandidateProfile?
  recruiterProfile         RecruiterProfile?
  agencyAdminProfile       AgencyAdminProfile?
  auditLogs                AdminAuditLog[]
  jobsPosted               RecruiterJob[]
  jobApplications          JobApplication[]
  assessments              SkillAssessment[]
  aiInterviews             AIInterviewResult[]
  notifications            Notification[]
  progressUpdates          CandidateProgressTracker[]
  progressUpdatesByMe      CandidateProgressTracker[] @relation("ProgressUpdatedBy")
  recruiterInvitationsSent RecruiterInvitation[]      @relation("RecruiterInvites")
  
  // Candidate Flow Phase 1 Relations
  candidateDocuments       CandidateDocument[]        @relation("CandidateDocuments")
  candidateSkills          CandidateSkill[]          @relation("CandidateSkills")
  skillExtractions         SkillExtraction[]         @relation("SkillExtractions")
  careerPredictions        CareerPrediction[]        @relation("CareerPredictions")
  jobRecommendations       JobRecommendation[]       @relation("JobRecommendations")
  candidateVector          CandidateVector?          @relation("CandidateVector")
  profileCompleteness      ProfileCompleteness?      @relation("ProfileCompleteness")
}

model CandidateProfile {
  candidate_id        String   @id
  resume_url          String?
  video_intro_url     String?
  skills              String?
  education           String?
  experience          String?
  preferred_locations String?
  languages           String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [candidate_id], references: [user_id])
}

model RecruiterProfile {
  recruiter_id     String   @id
  job_title        String?
  contact_number   String?
  linkedin_profile String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [recruiter_id], references: [user_id])
}

model AgencyAdminProfile {
  admin_id       String   @id
  phone_number   String?
  position       String?
  linkedin_url   String?
  company_role   String?
  branding_notes String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [admin_id], references: [user_id])
}

model AdminAuditLog {
  log_id       String   @id @default(uuid())
  admin_id     String
  action_type  String
  target_table String
  target_id    String
  description  String?
  created_at   DateTime @default(now())

  admin User @relation(fields: [admin_id], references: [user_id])
}

model RolePermission {
  permission_id String      @id @default(uuid())
  role_name     String
  module        String
  access_level  AccessLevel
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
}

enum AccessLevel {
  none
  read
  write
  manage
}

model RecruiterJob {
  job_id          String   @id @default(uuid())
  recruiter_id    String
  agency_id       String
  title           String
  location        String
  description     String
  salary_range    String?
  required_skills String?
  status          String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  recruiter        User                       @relation(fields: [recruiter_id], references: [user_id])
  agency           Agency                     @relation(fields: [agency_id], references: [agency_id])
  applications     JobApplication[]
  progressTrackers CandidateProgressTracker[]
  assessments      SkillAssessment[]
  jobRecommendations JobRecommendation[]      @relation("JobRecommendations")
  jobVector        JobVector?                 @relation("JobVector")
}

model JobApplication {
  application_id String   @id @default(uuid())
  candidate_id   String
  job_id         String
  status         String
  cover_letter   String?
  applied_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  candidate User               @relation(fields: [candidate_id], references: [user_id])
  job       RecruiterJob       @relation(fields: [job_id], references: [job_id])
  interview AIInterviewResult?
}

model CandidateProgressTracker {
  progress_id  String   @id @default(uuid())
  candidate_id String
  job_id       String
  stage        String
  updated_by   String
  notes        String?
  updated_at   DateTime @default(now())

  candidate User         @relation(fields: [candidate_id], references: [user_id])
  updatedBy User         @relation("ProgressUpdatedBy", fields: [updated_by], references: [user_id])
  job       RecruiterJob @relation(fields: [job_id], references: [job_id])
}

model AIInterviewResult {
  interview_id   String   @id @default(uuid())
  application_id String   @unique
  interview_type String
  score          String?
  video_url      String?
  feedback       String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  application  JobApplication @relation(fields: [application_id], references: [application_id])
  candidate    User           @relation(fields: [candidate_id], references: [user_id])
  candidate_id String
}

model SkillAssessment {
  assessment_id String    @id @default(uuid())
  candidate_id  String
  job_id        String
  provider      String
  score         String?
  status        String
  completed_at  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  candidate User         @relation(fields: [candidate_id], references: [user_id])
  job       RecruiterJob @relation(fields: [job_id], references: [job_id])
}

model Notification {
  notification_id String   @id @default(uuid())
  user_id         String
  type            String
  message         String
  is_read         Boolean  @default(false)
  sent_via        String
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])
}

model SubscriptionPlan {
  plan_id                  String   @id @default(uuid())
  name                     String
  price_monthly_usd      Decimal
  price_annually_usd     Decimal
  job_post_limit           Int
  ai_interview_limit       Int
  features_included        String
  is_publicly_available    Boolean
  stripe_price_id_monthly  String
  stripe_price_id_annually String
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  agencySubscriptions AgencySubscription[]
}

model AgencySubscription {
  agency_subscription_id String    @id @default(uuid())
  agency_id              String    @unique
  plan_id                String
  stripe_subscription_id String
  status                 String
  current_period_start   DateTime
  current_period_end     DateTime
  trial_ends_at          DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  agency Agency           @relation(fields: [agency_id], references: [agency_id])
  plan   SubscriptionPlan @relation(fields: [plan_id], references: [plan_id])
}

model WebhookEndpoint {
  webhook_id                  String    @id @default(uuid())
  agency_id                   String
  url                         String
  secret_key                  String
  subscribed_event_types      String
  status                      String
  last_successful_delivery_at DateTime?
  last_failed_delivery_at     DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  agency Agency @relation(fields: [agency_id], references: [agency_id])
}

model RecruiterInvitation {
  invitation_id String   @id @default(uuid())
  agency_id     String
  inviter_id    String
  email         String
  full_name     String
  position      String?
  status        String
  expires_at    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  agency  Agency @relation(fields: [agency_id], references: [agency_id])
  inviter User   @relation("RecruiterInvites", fields: [inviter_id], references: [user_id])
}

// ========== CANDIDATE FLOW PHASE 1 MODELS ==========

// Model for storing uploaded documents (CVs, resumes)
model CandidateDocument {
  document_id      String   @id @default(uuid())
  candidate_id     String
  file_name        String
  file_path        String
  file_type        String   // pdf, docx, etc.
  file_size        Int
  upload_status    String   // uploaded, processing, processed, failed
  extraction_status String? // pending, completed, failed
  processed_text   String?  // extracted text from document
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  candidate        User              @relation("CandidateDocuments", fields: [candidate_id], references: [user_id])
  skillExtractions SkillExtraction[]
  candidateSkills  CandidateSkill[]  @relation("SkillsFromDocument")
}

// Model for AI-extracted skills from documents
model CandidateSkill {
  skill_id       String   @id @default(uuid())
  candidate_id   String
  skill_name     String
  skill_category String?  // technical, soft, language, etc.
  proficiency    String?  // beginner, intermediate, advanced, expert
  years_experience Int?
  confidence_score Float?  // AI confidence in extraction (0-1)
  source_type    String   // cv_extraction, manual_input, assessment
  source_document_id String?
  is_verified    Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  candidate User @relation("CandidateSkills", fields: [candidate_id], references: [user_id])
  sourceDocument CandidateDocument? @relation("SkillsFromDocument", fields: [source_document_id], references: [document_id])
}

// Model for tracking skill extraction process
model SkillExtraction {
  extraction_id    String   @id @default(uuid())
  document_id      String
  candidate_id     String
  status           String   // pending, processing, completed, failed
  ai_provider      String   // openai, anthropic, etc.
  prompt_used      String?
  raw_response     String?  // raw AI response
  extracted_skills Json?    // structured skills data
  processing_time  Int?     // time taken in ms
  error_message    String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  document  CandidateDocument @relation(fields: [document_id], references: [document_id])
  candidate User              @relation("SkillExtractions", fields: [candidate_id], references: [user_id])
}

// Model for AI career predictions
model CareerPrediction {
  prediction_id       String   @id @default(uuid())
  candidate_id        String
  current_role        String?
  predicted_roles     Json     // array of predicted job roles with scores
  career_path         Json     // suggested career progression
  skill_gaps          Json     // skills needed for career growth
  salary_prediction   Json     // salary ranges for predicted roles
  confidence_score    Float    // overall confidence (0-1)
  ai_model_version    String
  input_data_summary  String?  // summary of data used for prediction
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  candidate User @relation("CareerPredictions", fields: [candidate_id], references: [user_id])
}

// Model for job recommendations and matching
model JobRecommendation {
  recommendation_id String   @id @default(uuid())
  candidate_id      String
  job_id            String
  match_score       Float    // 0-1 matching score
  skill_match       Json     // detailed skill matching analysis
  salary_match      Float?   // how well salary expectations match
  location_match    Float?   // location preference match
  experience_match  Float?   // experience level match
  ai_reasoning      String?  // explanation of the recommendation
  is_viewed         Boolean  @default(false)
  is_applied        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  candidate User         @relation("JobRecommendations", fields: [candidate_id], references: [user_id])
  job       RecruiterJob @relation("JobRecommendations", fields: [job_id], references: [job_id])
}

// Model for storing candidate profile vectors for matching
model CandidateVector {
  vector_id         String   @id @default(uuid())
  candidate_id      String   @unique
  skill_vector      Json     // vector representation of skills
  experience_vector Json     // vector representation of experience
  education_vector  Json     // vector representation of education
  combined_vector   Json     // combined vector for overall matching
  vector_version    String   // version of vectorization algorithm
  last_updated      DateTime @default(now())
  created_at        DateTime @default(now())

  candidate User @relation("CandidateVector", fields: [candidate_id], references: [user_id])
}

// Model for job vectors for matching
model JobVector {
  vector_id          String   @id @default(uuid())
  job_id             String   @unique
  requirements_vector Json    // vector representation of job requirements
  skills_vector      Json     // vector representation of required skills
  combined_vector    Json     // combined vector for matching
  vector_version     String   // version of vectorization algorithm
  last_updated       DateTime @default(now())
  created_at         DateTime @default(now())

  job RecruiterJob @relation("JobVector", fields: [job_id], references: [job_id])
}

// Model for tracking profile completeness
model ProfileCompleteness {
  completeness_id   String   @id @default(uuid())
  candidate_id      String   @unique
  overall_score     Float    // 0-100 overall completeness score
  basic_info_score  Float    // basic profile information score
  skills_score      Float    // skills section score
  experience_score  Float    // experience section score
  education_score   Float    // education section score
  document_score    Float    // uploaded documents score
  missing_fields    Json     // array of missing required fields
  suggestions       Json     // suggestions for improving profile
  last_calculated   DateTime @default(now())
  created_at        DateTime @default(now())

  candidate User @relation("ProfileCompleteness", fields: [candidate_id], references: [user_id])
}
