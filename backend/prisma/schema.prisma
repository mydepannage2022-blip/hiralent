generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  // Runtime (Prisma Client) uses `url` — this is the POOLED path. In prod it carries
  // connection_limit/pool_timeout params and (Wave 8) fronts PgBouncer (?pgbouncer=true).
  url       = env("DATABASE_URL")
  // Migrations (`prisma migrate`) use `directUrl` — the DIRECT, un-pooled path that
  // bypasses PgBouncer (transaction pooling breaks migrations). Runtime never uses it.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum EmployerAssessmentStatus {
  DRAFT
  PENDING_DOCUMENTS
  IN_REVIEW
  AUTO_APPROVED
  AUTO_REJECTED
  APPROVED
  REJECTED
  EXPIRED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum AgencyType {
  VISA
  RELOCATION
  INTEGRATION
}

enum AgencyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Agency {
  agency_id             String                    @id @default(uuid())
  name                  String
  email                 String?                   @unique
  phone                 String?
  type                  AgencyType?
  billing_contact_email String?
  owner_user_id         String?
  status                AgencyStatus              @default(PENDING)
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt
  approval_notes        String?
  approved_at           DateTime?
  approved_by           String?
  logo_url              String?
  website               String?
  accreditations        String[]
  average_case_duration Int?
  languages_supported   String[]
  license_expiry        DateTime?
  license_number        String?
  operating_countries   String[]
  rating                Float?
  service_categories    String[]
  service_description   String?
  success_rate          Float?
  total_cases_handled   Int?
  business_license_url  String?
  rejection_reason      String?
  subscription          AgencySubscription?
  jobs                  CompanyJob[]
  users                 User[]
  webhooks              WebhookEndpoint[]
  reviews               AgencyReview[]
  caseAssignments       CaseAssignment[]
  invitations           CompanyAgencyInvitation[]
  relocationAnalytics   RelocationAnalytics[]
  cases                 RelocationCase[]
  integrationCases      RelocationCase[] @relation("IntegrationAgency") // Integration agency cases
  housingCases          RelocationCase[] @relation("HousingAgency")
}

model User {
  user_id           String    @id @default(uuid())
  agency_id         String?
  email             String    @unique
  password_hash     String?   // nullable — OAuth users have no password
  full_name         String
  role              String // candidate, company_admin, agency_admin, superadmin
  is_email_verified Boolean
  phone_number      String?
  position          String?
  linkedin_url      String?
  company_role      String? // For company users: HR Manager, CEO, etc.
  branding_notes    String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  last_login_at     DateTime?

  // OAuth
  google_id         String?   @unique
  auth_provider     String    @default("local") // "local" | "google"

  // NEW: MFA Support
  mfa_secret         String? // TOTP secret for 2FA
  mfa_enabled        Boolean @default(false)
  mfa_recovery_codes String? // JSON array of SHA-256 hashed recovery codes

  // Payments (Wave 5) — external gateway customer handle. Populated from the
  // verified checkout/subscription webhook (Wave 5 S2); added here (nullable) so
  // one migration covers it. Never a secret.
  stripe_customer_id String? @unique

  // Relations
  agency             Agency?             @relation(fields: [agency_id], references: [agency_id], onDelete: SetNull)
  candidateProfile   CandidateProfile?
  companyProfile     CompanyProfile? // Changed from recruiterProfile
  agencyAdminProfile AgencyAdminProfile?
  auditLogs          AdminAuditLog[]
  jobsPosted         CompanyJob[] // Changed from RecruiterJob
  jobApplications    JobApplication[]
  assessments        SkillAssessment[]
  userAnalytics      UsageAnalytics[]    @relation("UserAnalytics")
  sessions           UserSession[]       @relation("UserSessions")

  // Inverse relations needed for Prisma
  candidateProgressTrackers CandidateProgressTracker[] @relation("CandidateProgressTrackers")
  progressUpdatedBy         CandidateProgressTracker[] @relation("ProgressUpdatedBy")

  aiInterviewResults        AIInterviewResult[]       @relation("CandidateAIResults")
  assignedInterviews        AIInterviewResult[]       @relation("AssignedInterviews")
  relocationCases           RelocationCase[]          @relation("CandidateRelocationCases")
  caseAssignments           CaseAssignment[]          @relation("AgentCaseAssignments")
  agencyReviews             AgencyReview[]            @relation("ClientReviews")
  companyInvites            CompanyAgencyInvitation[] @relation("CompanyInvites")
  jobRecommendations        JobRecommendation[]       @relation("JobRecommendations")
  notifications             Notification[]            @relation("UserNotifications")
  notificationPreferences   UserNotificationPreferences? @relation("UserNotificationPreferences")
  candidateDocuments        CandidateDocument[]       @relation("CandidateDocuments")
  candidateSkills           CandidateSkill[]          @relation("CandidateSkills")
  skillExtractions          SkillExtraction[]         @relation("SkillExtractions")
  careerPredictions         CareerPrediction[]        @relation("CareerPredictions")
  candidateVectors          CandidateVector[]         @relation("CandidateVector")
  profileCompleteness       ProfileCompleteness[]     @relation("ProfileCompleteness")
  // Removed user.assessmentResults (results accessed via SkillAssessment.assessmentResults)
  communicationLogsReceived CommunicationLog[]        @relation("ReceivedMessages")
  communicationLogsSent     CommunicationLog[]        @relation("SentMessages")
  generatedContents         GeneratedContent[]        @relation("GeneratedContent")
  aiFeedbacks               AIFeedback[]              @relation("AIFeedback")
  uploadedDocuments         UploadedDocument[]        @relation("UserUploadedDocuments")
  reactions            MessageReaction[]   @relation("UserReactions") 
  companyAssessments EmployerAssessment[] @relation("CompanyAssessments")
  // Removed candidateAssessments (invalid inverse)
  // Removed competeChallenges (invalid inverse)
  assessmentTemplatesCreated AssessmentTemplate[] @relation("UserAssessmentTemplatesCreated")

  conversationsParticipant1 Conversation[]    @relation("ConversationP1")
  conversationsParticipant2 Conversation[]    @relation("ConversationP2")
  messagesSent              Message[]         @relation("UserMessages")
  hiringAnalytics           HiringAnalytics[] @relation("CompanyAnalytics")
  subscriptions     UserSubscription[]  @relation("UserSubscriptions")
  payments          PaymentTransaction[] @relation("UserPayments")

  //new fields
  autofillSessions      ResumeAutofillSession[] @relation("AutofillSessions")
  candidateScore        CandidateScore?         @relation("CandidateScore")
  badges                BadgeAward[]            @relation("CandidateBadges")
  certifications        Certification[]         @relation("CandidateCertifications")
  chatConversations ChatConversation[] @relation("CandidateChatConversations")

  profileEvents         ProfileEvent[]          @relation("ProfileEvents")
  // Relations to Scraping Candidates models (Do not Touch !!!)
  sourcedCandidateLead SourcedCandidate? @relation("SourcedCandidateToUser")
  sourcingRunsTriggered SourcingRun[] @relation("SourcingRunTriggeredByUser")

    // Company Team Relations
  ownedCompanyTeam           CompanyTeamMember[]     @relation("CompanyTeamMembers")
  teamMemberships            CompanyTeamMember[]     @relation("UserTeamMemberships")
  teamMembersInvited         CompanyTeamMember[]     @relation("TeamMemberInviter")
  companyInvitationsSent     CompanyTeamInvitation[] @relation("SentInvitations")
  companyInvitationsReceived CompanyTeamInvitation[] @relation("CompanyInvitations")
  companyActivityLogs        CompanyActivityLog[]    @relation("CompanyActivityLogs")
  activityActions            CompanyActivityLog[]    @relation("ActivityActor")

  //Candidate skills assessment Relations (Do not touch)
  candidateAssessmentSessions CandidateAssessmentSession[]
  candidateAssessmentTelemetry CandidateAssessmentTelemetryEvent[]

  // ===== Simple Test Relations =====
  candidateSimpleTestInvites  CandidateJobSimpleTestInvite[]  @relation("CandidateSimpleTestInvites")
  companySimpleTestInvites    CandidateJobSimpleTestInvite[]  @relation("CompanySimpleTestInvites")
  candidateSimpleTestAttempts CandidateJobSimpleTestAttempt[] @relation("CandidateSimpleTestAttempts")
  companyJobSimpleTests       JobSimpleTest[]                 @relation("CompanyJobSimpleTests")

  // ===== Assessment Invite Relations =====
  candidateAssessmentInvites  CandidateAssessmentInvite[]     @relation("CandidateAssessmentInvites")
  companyAssessmentInvites    CandidateAssessmentInvite[]     @relation("CompanyAssessmentInvites")

}

// Enhanced Company Profile (Previously RecruiterProfile)
model CompanyProfile {
  company_id String @id

  // Basic Company Info
  company_name String? // Official registered company name
  display_name String? // Display name (can be different from legal name)
  slug         String?
  tagline      String? 
  industry     String? // Technology, Healthcare, Finance, etc.
  company_size String? // startup, small, medium, large, enterprise
  website      String?
  headquarters String? // Primary location
  founded_year Int?
  description  String? // Company description/about

  // Contact & Social
  contact_email    String? 
  contact_number   String?
  linkedin_profile String?
  twitter_handle   String?
  facebook_page    String?
  instagram_url    String?  // <-- ADD THIS
  youtube_url      String?  // <-- ADD THIS
  
  // Business Details
  business_type       String? // public, private, non-profit, government
  registration_number String? // Business registration number
  tax_id              String? // Tax identification number
  employee_count      Int? // Approximate number of employees
  annual_revenue      String? // Revenue range

  //  ADD THESE NEW FIELDS FOR VERIFICATION 
  full_address              String? // Complete registered address (street, building, city....)
  verification_status       String?   @default("unverified") // unverified, pending, verified, rejected
  verification_submitted_at DateTime? // When verification was submitted
  verification_notes        String? // Admin notes about verification

  // Hiring Details
  hiring_volume  String? // low, medium, high volume hiring
  typical_roles  String[] // Common roles they hire for
  hiring_regions String[] // Geographic regions they hire from/for
  benefits       String[] 
  culture_description String? 
  remote_policy  String? // fully_remote, hybrid, office_only

  // Platform Specific
  logo_url          String?
  banner_url        String?
  verified          Boolean   @default(false)
  verification_date DateTime?
  rating            Float? // Company rating from candidates
  total_jobs_posted Int? // Total jobs posted on platform
  active_jobs_count Int? // Currently active jobs

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [company_id], references: [user_id], onDelete: Cascade)
}

model Question {
  id          String   @id @default(cuid())
  title       String
  description String
  problemStatement String
  difficulty  String   // easy, medium, hard
  skillTags   String[]
  type        String   // coding, mcq, debugging
  canonicalSolution String
  testCases   Json     // { inputs: [], outputs: [] }
   // ADD Variation
  parameters  Json?    // Store variation parameters
  metadata    Json?    // Store variation metadata
  //ADD THESE MCQ FIELDS
  options           Json?
  correctAnswer     String?
  explanation       String?

  //restored the vectorisation fields
  vectorStored  Boolean @default(false)
  vectorId      String?
  embeddingHash String?



  status      String // draft, pending_review, approved, rejected
  createdBy   String? // user ID who created/generated
  aiGenerated Boolean  @default(false)
  source      String? // ai_generated, web_scraped, manual
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  isLibraryQuestion Boolean @default(false)
  assessments AssessmentQuestion[]   //  NEW
  templateAssessments AssessmentTemplateQuestion[] //Ihssane Puted This
  candidateAssessmentAnswers CandidateAssessmentAnswer[]
  simpleTestQuestions JobSimpleTestQuestion[]
  
  //  NEW (for pattern-generated questions)
  generatedFromPattern     Boolean @default(false)
  patternKey               String?  // "stackoverflow:123456"
  patternDifficultyVariant String?  // "easy" | "medium" | "hard"

  //  Diagram
  hasDiagram       Boolean   @default(false)
  diagramType      String?   // 'er', 'class', 'sequence', 'tree', 'architecture'
  diagramCode      String?   @db.Text  // Code Mermaid
  diagramImageUrl  String?   // URL Cloudinary
  diagramMetadata  Json?     // Métadonnées supplémentaires

  @@unique([patternKey, patternDifficultyVariant])


  @@map("questions")
}

model AlgorithmPattern {
  id            String   @id @default(cuid())
  source        String
  sourceId      String
  difficulty    String
  pattern       String
  domain        String
  tags          String[]
  constraints   Json
  inputStructure Json
  extractedAt   DateTime
  createdAt     DateTime @default(now())
  //  OPTIONAL
  questionsGenerated Boolean @default(false)

  @@unique([source, sourceId])
}

model ScrapingJobLog {
  id        String   @id @default(cuid())
  source    String
  status    String
  count     Int
  durationMs Int
  error     String?
  executedAt DateTime @default(now())
}

// Enhanced Agency Admin Profile
model AgencyAdminProfile {
  admin_id       String  @id
  phone_number   String?
  position       String?
  linkedin_url   String?
  company_role   String?
  branding_notes String?

  // Agency specific fields
  license_details  String? // Professional license details
  specialization   String[] // Areas of specialization
  languages        String[] // Languages spoken
  years_experience Int? // Years of experience in relocation services
  certifications   String[] // Professional certifications

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [admin_id], references: [user_id], onDelete: Cascade)
}

// Enhanced Job Model (Previously RecruiterJob)
model CompanyJob {
  job_id          String    @id @default(uuid())
  company_id      String // Changed from recruiter_id
  agency_id       String? // Optional: if job requires relocation services
  title           String
  location        String
  description     String
  salary_range    String?
  required_skills String[]
  status          JobStatus @default(DRAFT) // draft, active, paused, closed, cancelled

  // Enhanced Job Fields
  job_type              String? // full_time, part_time, contract, internship
  experience_level      String? // entry, mid, senior, executive
  education_level       String? // high_school, bachelor, master, phd
  remote_option         String? // fully_remote, hybrid, office_only
  visa_sponsored        Boolean? // Whether company sponsors visa
  relocation_assistance Boolean? // Whether company provides relocation help
  urgency_level         String? // low, medium, high, urgent
  department            String? // Engineering, Marketing, Sales, etc.
  reporting_to          String? // Position this role reports to
  team_size             Int? // Size of team this role will join

  // Application Settings
  application_deadline DateTime?
  max_applications     Int? // Maximum number of applications to accept
  auto_reject_after    Int? // Days after which to auto-reject
  screening_questions  String[] // Custom screening questions

  min_profile_score Float?   // e.g. 70
  required_fields   String[] @default([]) // e.g. ["resume_url","headline"]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company            User                       @relation(fields: [company_id], references: [user_id], onDelete: Cascade)
  agency             Agency?                    @relation(fields: [agency_id], references: [agency_id], onDelete: SetNull)
  applications       JobApplication[]
  progressTrackers   CandidateProgressTracker[]
  assessments        SkillAssessment[]
  jobRecommendations JobRecommendation[]        @relation("JobRecommendations")
  jobVector          JobVector?                 @relation("JobVector")
  relocationCases    RelocationCase[]           @relation("JobRelocationCases")
  interviewSchedules InterviewSchedule[] // Added relation without fields/references

  employerAssessments EmployerAssessment[] @relation("JobAssessments")
  //simple test (1 per job)
  simpleTest JobSimpleTest?
  simpleTestInvites  CandidateJobSimpleTestInvite[]
  simpleTestAttempts CandidateJobSimpleTestAttempt[]

  @@index([status])
  @@index([experience_level])
  @@index([created_at])
}

// JOB STATUS enum 
enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
  ARCHIVED
}

enum JobApplicationStatus {
  APPLIED
  ASSESSMENT_REQUIRED
  INTERVIEW_REQUIRED
  SCREENING
  SHORTLISTED
  OFFERED
  HIRED
  REJECTED
}

model JobApplication {
  application_id String   @id @default(uuid())
  candidate_id   String
  job_id         String
  status         JobApplicationStatus @default(APPLIED)
  cover_letter   String?
  applied_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // per-application scoring (store externally, not profile)
  relevance_score Float?        // 0..1 or 0..100 (choisis une échelle et garde-la partout)
  vector_score    Float?        // optional: keep for debug
  trigger         String?       // "INTERVIEW_REQUIRED" | "ASSESSMENT_REQUIRED" | "NO_TRIGGER"
  score_version   String?       // e.g. "v1" (optional but useful)
  scored_at       DateTime?     // last scoring timestamp

  // link to JobRecommendation row (nice for traceability)
  recommendation_id String?
  recommendation    JobRecommendation? @relation("ApplicationToRecommendation", fields: [recommendation_id], references: [recommendation_id], onDelete: SetNull)


  // Enhanced Application Fields
  salary_expectation  Float?
  available_from      DateTime? // When candidate can start
  visa_status         String? // citizen, permanent_resident, work_visa, student_visa, needs_sponsorship
  willing_to_relocate Boolean?
  current_location    String?

  // Screening & Assessment
  screening_answers  Json? // Answers to custom screening questions
  assessment_score   Float? // Overall assessment score
  interview_feedback String? // Interview feedback from company
  rejection_reason   String? // Reason for rejection

  candidate          User                @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
  job                CompanyJob          @relation(fields: [job_id], references: [job_id], onDelete: Cascade) // Changed relation
  interview          AIInterviewResult?
  interviewSchedules InterviewSchedule[] // Removed incorrect @relation syntax

  applicationScores JobApplicationScoreHistory[]
  events            JobApplicationEventOutbox[]
  // Simple test flow
  simpleTestInvite  CandidateJobSimpleTestInvite?
  simpleTestAttempts CandidateJobSimpleTestAttempt[] // one-to-many

  // Employer assessment invite flow
  assessmentInvites CandidateAssessmentInvite[]

  @@unique([candidate_id, job_id])
  @@index([candidate_id])
  @@index([job_id])
  @@index([status])
}

model JobApplicationScoreHistory {
  history_id     String   @id @default(uuid())
  application_id String

  // score snapshot
  relevance_score Float
  vector_score    Float?
  trigger         String?
  reason_codes    String[] @default([])
  missing_skills  String[] @default([])
  breakdown       Json?    // ex: skill_match json, weights, etc.

  created_at     DateTime @default(now())
  created_by     String?  // "system" | user_id | worker name
  source         String?  // "matching" | "apply" | "recompute" ...

  application JobApplication @relation(fields: [application_id], references: [application_id], onDelete: Cascade)

  @@index([application_id])
  @@index([created_at])
}

enum JobApplicationEventType {
  APPLIED_CREATED
  ASSESSMENT_REQUIRED
  INTERVIEW_REQUIRED
  STATUS_UPDATED
}

enum JobApplicationEventStatus {
  PENDING
  SENT
  FAILED
}

model JobApplicationEventOutbox {
  event_id       String   @id @default(uuid())
  application_id String
  type           JobApplicationEventType

  payload        Json?
  status         JobApplicationEventStatus @default(PENDING)
  attempts       Int      @default(0)
  last_error     String?

  // idempotency (important)
  dedupe_key     String?  @unique

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  application JobApplication @relation(fields: [application_id], references: [application_id], onDelete: Cascade)

  @@index([status])
  @@index([application_id])
  @@index([type])
  @@index([created_at])
}

model CandidateProgressTracker {
  progress_id  String     @id @default(uuid())
  candidate_id String
  job_id       String
  stage        String // applied, screening, shortlisted, interviewed, offered, hired, rejected
  updated_by   String
  notes        String?
  updated_at   DateTime   @default(now())
  candidate    User       @relation("CandidateProgressTrackers", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  job          CompanyJob @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  updatedBy    User       @relation("ProgressUpdatedBy", fields: [updated_by], references: [user_id], onDelete: Cascade)
}

model AIInterviewResult {
  interview_id   String         @id @default(uuid())
  application_id String         @unique
  interview_type String
  score          String?
  video_url      String?
  feedback       String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  candidate_id   String
  application    JobApplication @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  candidate      User           @relation("CandidateAIResults", fields: [candidate_id], references: [user_id], onDelete: Cascade)

  // AI Video Interview Fields
  status              AIInterviewStatus @default(PENDING)
  transcript          Json?             // Full conversation transcript [{role, content, timestamp}]
  questions_asked     Json?             // Array of questions with metadata
  responses           Json?             // Array of candidate responses with analysis
  soft_skills         Json?             // Detected soft skills {communication, problemSolving, etc.}
  sentiment_analysis  Json?             // Sentiment data {overall, perResponse[]}
  duration_seconds    Int?              // Total interview duration
  total_questions     Int?              // Number of questions asked
  qualification       AIQualification?  // Final result: QUALIFIED or NOT_QUALIFIED
  evaluation_details  Json?             // Full evaluation: {fitScore, strengths, areasForImprovement, redFlags, confidenceInAssessment}
  started_at          DateTime?         // When interview started
  completed_at        DateTime?         // When interview completed
  job_id              String?           // Reference to the job being interviewed for

  // Recruiter Assignment Fields
  scheduled_date      DateTime?         // When the interview is scheduled for
  assigned_by         String?           // Recruiter user_id who assigned the interview
  assigned_at         DateTime?         // When the interview was assigned
  assignedByUser      User?             @relation("AssignedInterviews", fields: [assigned_by], references: [user_id], onDelete: SetNull)

  // Proctoring
  cheating_events     Json?             // [{type: 'NO_FACE'|'MULTIPLE_FACES', timestamp, faceCount}]

  // Question distribution
  soft_skill_weight   Int?              @default(70) // % of soft skill questions (0-100), rest is technical

  @@index([candidate_id, created_at])
  @@index([status])
}

enum AIInterviewStatus {
  PENDING       // Interview created but not started
  IN_PROGRESS   // Candidate is currently in the interview
  COMPLETED     // Interview finished successfully
  FAILED        // Technical failure or error
  EXPIRED       // Interview link expired
  CANCELLED     // Interview was cancelled
}

enum AIQualification {
  QUALIFIED
  NOT_QUALIFIED
  PENDING_REVIEW
}

model SkillAssessment {
  assessment_id String           @id @default(uuid())
  candidate_id  String
  job_id        String?
  provider      String
  score         String?
  status        AssessmentStatus @default(PENDING)
  completed_at  DateTime?
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  // AI Skill Assessment Fields
  assessment_type    AssessmentType     @default(COMPREHENSIVE)
  skill_category     String
  difficulty         DifficultyLevel    @default(BEGINNER)
  total_questions    Int                @default(20)
  time_limit         Int                @default(30)
  current_question   Int                @default(0)
  started_at         DateTime?
  questions          Json
  answers            Json
  overall_score      Float?
  skill_level_result String?
  strengths          String[]
  weaknesses         String[]
  recommendations    String[]
  ai_analysis        Json?
  confidence_score   Float?
  employer_assessment_id String?
  employer_assessment    EmployerAssessment? @relation("EmployerToCandidateAssessments", fields: [employer_assessment_id], references: [assessment_id], onDelete: SetNull)

  summary            AssessmentSummary?
  assessmentResults  AssessmentResult[] @relation("AssessmentResults")
  candidate          User               @relation(fields: [candidate_id], references: [user_id], onDelete: Cascade)
  job                CompanyJob?        @relation(fields: [job_id], references: [job_id], onDelete: SetNull)

  @@index([candidate_id, created_at])
  @@index([status])
  @@map("skill_assessments")
}

model RelocationCase {
  case_id      String  @id @default(uuid())
  candidate_id String
  job_id       String? // Optional: linked to specific job
  agency_id    String
  housing_agency_id     String?
  case_number  String  @unique // Human readable case number

  // Case Details
  service_type         String // visa_processing, housing_assistance, documentation, full_relocation
  priority_level       String // low, medium, high, urgent
  status               String // initiated, in_progress, pending_documents, completed, cancelled
  estimated_completion DateTime?
  actual_completion    DateTime?

  // Locations
  origin_country      String
  destination_country String
  destination_city    String?

  // Financial
  estimated_cost Float?
  actual_cost    Float?
  payment_status String? // pending, partial, paid, refunded

  // Case Management
  case_manager_id    String? // Assigned case manager
  notes              String?
  documents_required String[] // List of required documents
  documents_received String[] // List of received documents

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  candidate   User                 @relation("CandidateRelocationCases", fields: [candidate_id], references: [user_id], onDelete: Cascade)
  job         CompanyJob?          @relation("JobRelocationCases", fields: [job_id], references: [job_id], onDelete: SetNull)
  agency      Agency               @relation(fields: [agency_id], references: [agency_id], onDelete: Cascade)
  housingAgency     Agency?        @relation("HousingAgency", fields: [housing_agency_id], references: [agency_id], onDelete: SetNull)
  housing_details   HousingArrangement?
  assignments CaseAssignment[]
  updates     CaseProgressUpdate[]
  documents   CaseDocument[]

  embassy_submission  EmbassySubmission?

  integration_agency_id String?

  // Relations
  integrationAgency     Agency? @relation("IntegrationAgency", fields: [integration_agency_id], references: [agency_id], onDelete: SetNull)

  integrationServices   IntegrationService[] @relation("IntegrationServices")

