# ===========================================
# talent-ai-service / matching-candidate-job — Environment Example
# ===========================================
# Copy to `.env`. Never commit `.env` — SERVICE_API_KEY, BACKEND_INTERNAL_TOKEN and
# GEMINI_API_KEY are secrets. Uses Qdrant as the vector store.

# ---------- Service ----------
ENV=development
SERVICE_NAME=matching-candidate-job
PORT=8004
SERVICE_API_KEY=CHANGE_ME_service_key            # secret — X-Service-Key auth

# ---------- Redis / worker queue ----------
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=matching:queue
REDIS_DLQ_NAME=matching:dlq
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_SECONDS=2

# ---------- Qdrant (vector store) ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_JOBS=jobs
QDRANT_COLLECTION_CANDIDATES=candidates
VECTOR_SIZE=768

# ---------- Embeddings ----------
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# ---------- Gemini AI ----------
GEMINI_API_KEY=                                  # secret
GEMINI_MODEL=models/gemini-2.0-flash

# ---------- Backend integration ----------
BACKEND_BASE_URL=http://localhost:5000
BACKEND_INTERNAL_TOKEN=CHANGE_ME_backend_token   # secret
