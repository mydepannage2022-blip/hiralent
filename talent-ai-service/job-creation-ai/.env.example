# ===========================================
# talent-ai-service / job-creation-ai — Environment Example
# ===========================================
# Copy to `.env`. Never commit `.env` — GEMINI_API_KEY is a secret.

# ---------- Gemini AI ----------
GEMINI_API_KEY=                                  # secret — get from Google AI Studio
GEMINI_MODEL=models/gemini-2.0-flash

# ---------- Internal service auth (Phase 1.7) ----------
# Shared secret the Node backend sends as the X-API-Token header on /api/v1/job-ai/*.
# Unset = fail-closed (500). MUST match INTERNAL_API_TOKEN in backend/.env.
INTERNAL_API_TOKEN=CHANGE_ME_internal_token       # secret
