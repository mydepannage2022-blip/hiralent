# ===========================================
# talent-ai-service / scraping-candidates — Environment Example
# ===========================================
# Copy to `.env`. Never commit `.env` — tokens/keys are secrets.

# ---------- Service ----------
SERVICE_NAME=scraping-candidates
ENV=local
API_HOST=0.0.0.0
API_PORT=8010

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Backend integration ----------
BACKEND_BASE_URL=http://localhost:5000
BACKEND_INTERNAL_TOKEN=CHANGE_ME_backend_token   # secret

# ---------- Source toggles ----------
ENABLE_GITHUB=true
ENABLE_GREENHOUSE=false
ENABLE_LEVER=false

# ---------- Source credentials (secrets) ----------
GITHUB_TOKEN=
GREENHOUSE_API_KEY=
LEVER_API_KEY=

# ---------- HTTP tuning ----------
HTTP_TIMEOUT_SEC=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_MIN_SEC=0.5
HTTP_BACKOFF_MAX_SEC=4.0
