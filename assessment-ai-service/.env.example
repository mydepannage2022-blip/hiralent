# ===========================================
# assessment-ai-service — Environment Example
# ===========================================
# Copy to `.env`. Never commit `.env` — GOOGLE_API_KEY and INTERNAL_API_TOKEN are secrets.

# ---------- Service ----------
SERVICE_NAME=ai-assessment
SERVICE_ENV=development
SERVICE_PORT=8001

# ---------- Internal auth ----------
INTERNAL_API_TOKEN=CHANGE_ME_internal_token      # rotate before prod (Wave 1)

# ---------- Redis (optional) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Gemini AI ----------
GOOGLE_API_KEY=                                  # secret — get from Google AI Studio

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- NLP ----------
SPACY_MODEL=en_core_web_sm
