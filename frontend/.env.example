# ===========================================
# Hiralent Frontend (Next.js) — Environment Example
# ===========================================
# Copy to `.env`. NEXT_PUBLIC_* vars are baked into the client bundle at BUILD time,
# so set them per-environment before `next build`. Never put secrets in NEXT_PUBLIC_*.

# ---------- API / socket endpoints ----------
# CANONICAL (R-27): NEXT_PUBLIC_API_URL is the BARE backend host — scheme + host + port only,
# NO /api or /api/v1 suffix. The central resolver (src/lib/config/api.ts) derives the REST base
# (/api/v1), the legacy /api base (OCR only) and the socket host from it. Set this per environment
# before `next build` (NEXT_PUBLIC_* are baked into the client bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# Deprecated — accepted only as a backward-compat fallback (resolver strips a trailing /api/v1).
# Prefer NEXT_PUBLIC_API_URL above. Do not set both.
# NEXT_PUBLIC_BASE_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ---------- Assets ----------
LOGO_PATH=/images/logo.png

# ---------- Client limits / socket tuning ----------
NEXT_PUBLIC_MAX_FILE_SIZE=10485760               # 10 MB
NEXT_PUBLIC_SOCKET_RECONNECT_ATTEMPTS=5

# ---------- Debug toggles (optional) ----------
NEXT_PUBLIC_DEBUG_SOCKET=false
# NEXT_PUBLIC_DEBUG_MESSAGES=false

# ---------- Environment ----------
# NODE_ENV=development

# ---------- Dev-only auth helpers (leave unset outside local dev) ----------
# NEXT_PUBLIC_DEV_TOKEN=
# NEXT_PUBLIC_DEV_TOKEN_KEY=
# NEXT_PUBLIC_DEV_TOKEN_STORE=
# NEXT_PUBLIC_DEV_USER=
