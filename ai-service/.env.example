# ===========================================
# ai-service (QuestionBank / coding-question vetting) — Environment Example
# ===========================================
# Copy to `.env`. Never commit `.env` — GEMINI_API_KEY is a secret.

# ---------- API Configuration ----------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ---------- AI Configuration ----------
GEMINI_API_KEY=                                  # secret — get from Google AI Studio
AI_MODEL=gemini-2.5-flash
# Gemini safety threshold (R-34) — NOT disabled. One of BLOCK_ONLY_HIGH,
# BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE. Invalid -> BLOCK_ONLY_HIGH.
GEMINI_SAFETY_THRESHOLD=BLOCK_ONLY_HIGH

# ---------- External Services ----------
NODE_BACKEND_URL=http://localhost:5000

# ---------- Hardened code runner (R-03) ----------
# Question-vetting runs the canonical solution in the SINGLE hardened runner-python HTTP runner
# (containerized, fail-closed). RUNNER_STUB_TOKEN must match the runner's + backend's value.
RUNNER_HTTP_URL=http://localhost:8001
RUNNER_STUB_TOKEN=CHANGE_ME_runner_stub_token       # secret — must match runner-python + backend

# ---------- Internal service auth (Phase 1.7) ----------
# Shared secret the Node backend sends as the X-API-Token header. Every non-public
# endpoint requires it; unset = fail-closed (500). MUST match INTERNAL_API_TOKEN in
# backend/.env.
INTERNAL_API_TOKEN=CHANGE_ME_internal_token       # secret

# ---------- CORS (Phase 1.5) ----------
# Comma-separated allowlist of browser origins. No wildcard "*" with credentials.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5000

# ---------- Web Scraping ----------
REQUEST_TIMEOUT=30
# Optional scraper credentials (secrets):
# GITHUB_TOKEN=
# LEETCODE_SESSION=
# LEETCODE_CSRF=
# STACKEXCHANGE_KEY=
# CLOUDINARY_URL=
